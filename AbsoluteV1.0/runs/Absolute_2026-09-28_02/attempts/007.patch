index 0000000..d1ecb2e
--- /dev/null
+++ b/pps_pallet_pose_cpp/test/test_sent_deferred_roster.py
@@ -0,0 +1,382 @@
+"""Sent and deferred Detection2DArray slots for one synchronized pair.
+
+Stage 2 still runs once, on the class-matched candidate select_detection
+already chose. That candidate's source index is the pallet sent through
+stage 2. The other class-matched source indices, in the same order, are
+deferred. A tie keeps the earlier slot sent because std::max_element
+returns the first maximum. Index 0 is a real slot.
+
+On a successful estimate both lists are written onto PalletPoseStamped
+after this pair's depth stamp. On stage-2 failure no PalletPoseStamped is
+published; the same two lists are two KeyValue entries on the existing
+WARN diagnostic. An empty deferred list is an empty int32[] on the pose
+and an empty string on that diagnostic. An empty candidate list and a
+depth-conversion exception still publish nothing.
+"""
+
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+PACKAGE_SRC = Path(__file__).resolve().parents[2]
+NODE_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "pallet_pose_node.cpp"
+NODE_HPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "pallet_pose_node.hpp"
+UTILS_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "detection_utils.cpp"
+POSE_MSG = PACKAGE_SRC / "pps_perception_msgs" / "msg" / "PalletPoseStamped.msg"
+
+
+class _Continue(Exception):
+    pass
+
+
+def function_body(text: str, name: str) -> str:
+    start = text.find(name)
+    if start < 0:
+        raise AssertionError(f"{name} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{name} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{name} body does not close")
+
+
+def defined_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        raise AssertionError(f"{signature} is missing")
+    return function_body(text[start:], signature)
+
+
+def declaration(text: str, name: str) -> str:
+    start = text.find(name)
+    if start < 0:
+        raise AssertionError(f"{name} is missing")
+    end = text.find(";", start)
+    if end < 0:
+        raise AssertionError(f"{name} declaration does not end")
+    return text[start:end]
+
+
+def message_fields(text: str) -> list[tuple[str, str]]:
+    fields = []
+    for raw in text.splitlines():
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        fields.append((parts[0], parts[1].split("=", 1)[0]))
+    return fields
+
+
+def _statements(body: str) -> list:
+    lines = []
+    for raw in body.splitlines():
+        line = raw.strip()
+        if not line or line.startswith("//"):
+            continue
+        lines.append(line)
+    return _parse_block(lines, 0)[0]
+
+
+def _parse_block(lines: list[str], index: int) -> tuple[list, int]:
+    statements: list = []
+    while index < len(lines):
+        line = lines[index]
+        if line == "}":
+            return statements, index + 1
+        if line.endswith("{"):
+            nested, index = _parse_block(lines, index + 1)
+            statements.append((line[:-1].strip(), nested))
+            continue
+        statements.append(line)
+        index += 1
+    return statements, index
+
+
+def _lookup(expr: str, env: dict):
+    expr = expr.strip().rstrip(";")
+    if expr in env:
+        return env[expr]
+    raise AssertionError(f"unknown name {expr}")
+
+
+def _execute(statements: list, env: dict):
+    for statement in statements:
+        if isinstance(statement, tuple):
+            header, nested = statement
+            if header.startswith("for ("):
+                inner = header[len("for (") :].strip()
+                if inner.endswith(")"):
+                    inner = inner[:-1].strip()
+                declared, collection = [part.strip() for part in inner.split(":")]
+                loop_name = declared.split()[-1]
+                for item in list(env[collection]):
+                    env[loop_name] = item
+                    try:
+                        _execute(nested, env)
+                    except _Continue:
+                        continue
+                continue
+            if header.startswith("if ("):
+                cond = header[len("if (") :].strip()
+                if cond.endswith(")"):
+                    cond = cond[:-1].strip()
+                if cond == "!joined.empty()":
+                    matched = env["joined"] != ""
+                elif "==" in cond:
+                    left, right = [part.strip() for part in cond.split("==")]
+                    matched = _lookup(left, env) == _lookup(right, env)
+                else:
+                    raise AssertionError(f"unsupported condition: {cond}")
+                if matched:
+                    _execute(nested, env)
+                continue
+            raise AssertionError(f"unsupported block: {header}")
+        if statement == "continue;":
+            raise _Continue()
+        if statement.startswith("std::string "):
+            env[statement[len("std::string ") :].rstrip(";").strip()] = ""
+            continue
+        if statement.startswith("std::vector<int> "):
+            env[statement[len("std::vector<int> ") :].rstrip(";").strip()] = []
+            continue
+        if statement.startswith("return "):
+            return _lookup(statement[len("return ") :], env)
+        if ".push_back(" in statement and statement.endswith(");"):
+            target, arg = statement[:-2].split(".push_back(", 1)
+            arg = arg.strip()
+            if arg == "','":
+                env[target.strip()] += ","
+            else:
+                env[target.strip()].append(_lookup(arg, env))
+            continue
+        if "+=" in statement and statement.endswith(";"):
+            target, expr = statement[:-1].split("+=", 1)
+            expr = expr.strip()
+            prefix = "std::to_string("
+            if not (expr.startswith(prefix) and expr.endswith(")")):
+                raise AssertionError(f"unsupported append: {statement}")
+            env[target.strip()] += str(_lookup(expr[len(prefix) : -1], env))
+            continue
+        raise AssertionError(f"unsupported statement: {statement}")
+    return None
+
+
+def indices_left_deferred(source_indices: list[int], stage2_source_index: int) -> list[int]:
+    text = NODE_CPP.read_text(encoding="utf-8")
+    body = defined_body(text, "std::vector<int> indices_left_deferred(")
+    result = _execute(
+        _statements(body),
+        {"source_indices": list(source_indices), "stage2_source_index": stage2_source_index},
+    )
+    if not isinstance(result, list):
+        raise AssertionError("indices_left_deferred did not return the deferred slots")
+    return result
+
+
+def join_deferred_indices(deferred: list[int]) -> str:
+    text = NODE_CPP.read_text(encoding="utf-8")
+    body = defined_body(text, "std::string join_deferred_indices(")
+    result = _execute(_statements(body), {"deferred": list(deferred)})
+    if not isinstance(result, str):
+        raise AssertionError("join_deferred_indices did not return one string")
+    return result
+
+
+class SentDeferredRosterTest(unittest.TestCase):
+    def test_deferred_slots_keep_candidate_order_and_omit_only_the_sent_index(self) -> None:
+        self.assertEqual(indices_left_deferred([0, 1, 2], 1), [0, 2])
+        self.assertEqual(indices_left_deferred([2, 0, 5], 0), [2, 5])
+        self.assertEqual(indices_left_deferred([0, 3], 0), [3])
+        self.assertEqual(indices_left_deferred([1, 4], 1), [4])
+        self.assertEqual(indices_left_deferred([4], 4), [])
+        self.assertEqual(indices_left_deferred([10, 2], 10), [2])
+        self.assertNotIn(1, indices_left_deferred([0, 1, 2], 1))
+
+    def test_tie_keeps_the_earlier_slot_sent(self) -> None:
+        body = function_body(UTILS_CPP.read_text(encoding="utf-8"), "select_detection")
+        self.assertEqual(body.count("std::max_element"), 2)
+        self.assertIn("if (a.score != b.score) return a.score < b.score;", body)
+        self.assertIn("return a.area_px < b.area_px;", body)
+        # Equal score and area: the comparator is false both ways, so the
+        # first maximum stays sent and the later slot is deferred.
+        self.assertEqual(indices_left_deferred([1, 4], 1), [4])
+        self.assertEqual(indices_left_deferred([0, 2, 2], 0), [2, 2])
+
+    def test_deferred_diagnostic_value_is_one_comma_separated_string(self) -> None:
+        self.assertEqual(join_deferred_indices([0, 2]), "0,2")
+        self.assertEqual(join_deferred_indices([2, 5]), "2,5")
+        self.assertEqual(join_deferred_indices([4]), "4")
+        self.assertEqual(join_deferred_indices([0]), "0")
+        self.assertEqual(join_deferred_indices([1, 10]), "1,10")
+        self.assertEqual(join_deferred_indices([]), "")
+        self.assertEqual(join_deferred_indices([1, 10]).split(","), ["1", "10"])
+
+    def test_pose_message_lists_both_sides_after_the_depth_stamp(self) -> None:
+        fields = message_fields(POSE_MSG.read_text(encoding="utf-8"))
+        self.assertEqual(
+            fields[-4:],
+            [
+                ("builtin_interfaces/Time", "input_rgb_stamp"),
+                ("builtin_interfaces/Time", "input_depth_stamp"),
+                ("int32", "stage2_source_index"),
+                ("int32[]", "deferred_source_indices"),
+            ],
+        )
+        names = [name for _, name in fields]
+        self.assertEqual(names.count("stage2_source_index"), 1)
+        self.assertEqual(names.count("deferred_source_indices"), 1)
+        for kept in (
+            "header",
+            "pose",
+            "yaw_rad",
+            "face_normal_rgb",
+            "plane_inlier_ratio",
+            "n_face_points",
+            "chamfer_cost_m",
+            "accepted",
+            "failure_reason",
+            "geometry_source",
+            "preset_id",
+        ):
+            self.assertIn(kept, names)
+
+    def test_success_writes_the_roster_on_the_pose_and_failure_writes_it_on_the_diagnostic(self) -> None:
+        cpp = NODE_CPP.read_text(encoding="utf-8")
+        hpp = NODE_HPP.read_text(encoding="utf-8")
+        on_pair = function_body(cpp, "PalletPoseNode::on_pair")
+        pose = function_body(cpp, "PalletPoseNode::publish_pose")
+        failure = function_body(cpp, "PalletPoseNode::publish_failure_diagnostics")
+        ok = function_body(cpp, "PalletPoseNode::publish_ok_diagnostics")
+
+        self.assertIn("int stage2_source_index", declaration(hpp, "void publish_pose("))
+        self.assertIn("const std::vector<int>& deferred", declaration(hpp, "void publish_pose("))
+        self.assertIn("int stage2_source_index", declaration(hpp, "void publish_failure_diagnostics("))
+        self.assertIn("const std::vector<int>& deferred", declaration(hpp, "void publish_failure_diagnostics("))
+        ok_decl = declaration(hpp, "void publish_ok_diagnostics(")
