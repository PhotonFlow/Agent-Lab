+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// This synchronized capture. stage2_source_index is the Detection2DArray slot
+// select_detection sent through stage 2. The other class-matched slots stay
+// in candidate order and are not posed.
+struct SentDeferredRoster {
+  int stage2_source_index = 0;
+  std::vector<int> deferred_source_indices;
+};
+
+template <typename Candidate>
+inline SentDeferredRoster make_sent_deferred_roster(const std::vector<Candidate>& candidates,
+                                                    int sent_source_index) {
+  SentDeferredRoster roster;
+  roster.stage2_source_index = sent_source_index;
+  for (const auto& candidate : candidates) {
+    if (candidate.source_index == sent_source_index) {
+      continue;
+    }
+    roster.deferred_source_indices.push_back(candidate.source_index);
+  }
+  return roster;
+}
+
+// One diagnostic value. Empty when this pair had one class-matched candidate.
+inline std::string format_deferred_source_indices(const std::vector<int>& deferred_source_indices) {
+  std::string text;
+  for (int source_index : deferred_source_indices) {
+    if (!text.empty()) {
+      text += ',';
+    }
+    text += std::to_string(source_index);
+  }
+  return text;
+}
+
+}  // namespace pps_pallet_pose_cpp
