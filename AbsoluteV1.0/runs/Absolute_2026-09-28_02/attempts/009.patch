diff --git a/pps_pallet_pose_cpp/test/test_pair_sent_deferred_roster.py b/pps_pallet_pose_cpp/test/test_pair_sent_deferred_roster.py
new file mode 100644
index 0000000..d9808d2
--- /dev/null
+++ b/pps_pallet_pose_cpp/test/test_pair_sent_deferred_roster.py
@@ -0,0 +1,366 @@
+"""Sent and deferred slots for one synchronized detection and depth pair.
+
+Stage 2 runs once, on the class-matched candidate select_detection already
+chose. That candidate's Detection2DArray slot is the pallet sent through
+stage 2. The other class-matched slots stay deferred, in that same order.
+A tie keeps the earlier slot sent. Slot 0 is a real detection.
+
+A successful estimate writes both lists onto PalletPoseStamped after this
+pair's depth stamp. A failed estimate publishes no PalletPoseStamped; the
+same two lists are two KeyValue entries on the existing WARN diagnostic.
+An empty deferred list is an empty int32[] on the pose and an empty string
+on that diagnostic. An empty candidate list and a depth-conversion
+exception still publish nothing.
+"""
+
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+PACKAGE_SRC = Path(__file__).resolve().parents[2]
+NODE_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "pallet_pose_node.cpp"
+NODE_HPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "pallet_pose_node.hpp"
+UTILS_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "detection_utils.cpp"
+ROSTER_HPP = (
+    PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "sent_deferred_roster.hpp"
+)
+POSE_MSG = PACKAGE_SRC / "pps_perception_msgs" / "msg" / "PalletPoseStamped.msg"
+
+
+class _Continue(Exception):
+    pass
+
+
+def _read(path: Path) -> str:
+    if not path.is_file():
+        raise AssertionError(f"{path.name} is missing")
+    return path.read_text(encoding="utf-8")
+
+
+def function_body(text: str, name: str) -> str:
+    start = text.find(name)
+    if start < 0:
+        raise AssertionError(f"{name} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{name} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{name} body does not close")
+
+
+def message_fields(text: str) -> list[tuple[str, str]]:
+    fields = []
+    for raw in text.splitlines():
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        fields.append((parts[0], parts[1].split("=", 1)[0]))
+    return fields
+
+
+def _statements(body: str) -> list:
+    lines = []
+    for raw in body.splitlines():
+        line = raw.strip()
+        if not line or line.startswith("//"):
+            continue
+        lines.append(line)
+    return _parse_block(lines, 0)[0]
+
+
+def _parse_block(lines: list[str], index: int) -> tuple[list, int]:
+    statements: list = []
+    while index < len(lines):
+        line = lines[index]
+        if line == "}":
+            return statements, index + 1
+        if line.endswith("{"):
+            nested, index = _parse_block(lines, index + 1)
+            statements.append((line[:-1].strip(), nested))
+            continue
+        statements.append(line)
+        index += 1
+    return statements, index
+
+
+def _lookup(expr: str, env: dict):
+    expr = expr.strip().rstrip(";")
+    if expr in env:
+        return env[expr]
+    if "." in expr:
+        obj, member = expr.split(".", 1)
+        return env[obj][member]
+    raise AssertionError(f"unknown name {expr}")
+
+
+def _execute(statements: list, env: dict):
+    for statement in statements:
+        if isinstance(statement, tuple):
+            header, nested = statement
+            if header.startswith("for ("):
+                inner = header[len("for (") :].rstrip(")")
+                declared, collection = [part.strip() for part in inner.split(":")]
+                loop_name = declared.split()[-1]
+                for item in list(_lookup(collection, env)):
+                    env[loop_name] = item
+                    try:
+                        _execute(nested, env)
+                    except _Continue:
+                        continue
+                continue
+            if header.startswith("if ("):
+                cond = header[len("if (") :].strip()
+                if cond.endswith(")"):
+                    cond = cond[:-1].strip()
+                if cond.startswith("!") and cond.endswith(".empty()"):
+                    matched = _lookup(cond[1 : -len(".empty()")], env) not in ("", [])
+                elif "==" in cond:
+                    left, right = [part.strip() for part in cond.split("==")]
+                    matched = _lookup(left, env) == _lookup(right, env)
+                else:
+                    raise AssertionError(f"unsupported condition: {cond}")
+                if matched:
+                    _execute(nested, env)
+                continue
+            raise AssertionError(f"unsupported block: {header}")
+        if statement == "continue;":
+            raise _Continue()
+        if statement.startswith("SentDeferredRoster "):
+            env[statement[len("SentDeferredRoster ") :].rstrip(";").strip()] = {
+                "stage2_source_index": 0,
+                "deferred_source_indices": [],
+            }
+            continue
+        if statement.startswith("std::string "):
+            env[statement[len("std::string ") :].rstrip(";").strip()] = ""
+            continue
+        if statement.startswith("return "):
+            return _lookup(statement[len("return ") :], env)
+        if ".push_back(" in statement and statement.endswith(");"):
+            target, arg = statement[:-2].split(".push_back(", 1)
+            _lookup(target.strip(), env).append(_lookup(arg.strip(), env))
+            continue
+        if "+=" in statement and statement.endswith(";"):
+            target, expr = [part.strip() for part in statement[:-1].split("+=", 1)]
+            if expr == "','":
+                env[target] += ","
+            elif expr.startswith("std::to_string(") and expr.endswith(")"):
+                env[target] += str(_lookup(expr[len("std::to_string(") : -1], env))
+            else:
+                raise AssertionError(f"unsupported append: {statement}")
+            continue
+        if " = " in statement and statement.endswith(";"):
+            target, expr = [part.strip() for part in statement[:-1].split(" = ", 1)]
+            value = _lookup(expr, env)
+            if "." in target:
+                obj, member = target.split(".", 1)
+                env[obj][member] = value
+            else:
+                env[target] = value
+            continue
+        raise AssertionError(f"unsupported statement: {statement}")
+    return None
+
+
+def _run(signature: str, env: dict):
+    body = function_body(_read(ROSTER_HPP), signature)
+    return _execute(_statements(body), env)
+
+
+def make_sent_deferred_roster(slots: list[int], sent_slot: int) -> dict:
+    result = _run(
+        "make_sent_deferred_roster(",
+        {
+            "candidates": [{"source_index": slot} for slot in slots],
+            "sent_source_index": sent_slot,
+        },
+    )
+    if not isinstance(result, dict):
+        raise AssertionError("make_sent_deferred_roster did not return the sent and deferred slots")
+    return result
+
+
+def format_deferred_source_indices(deferred: list[int]) -> str:
+    result = _run(
+        "format_deferred_source_indices(",
+        {"deferred_source_indices": list(deferred)},
+    )
+    if not isinstance(result, str):
+        raise AssertionError("format_deferred_source_indices did not return one string")
+    return result
+
+
+def _between(text: str, start_mark: str, end_mark: str) -> str:
+    start = text.find(start_mark)
+    if start < 0:
+        raise AssertionError(f"{start_mark} is missing")
+    end = text.find(end_mark, start + len(start_mark))
+    if end < 0:
+        raise AssertionError(f"{end_mark} is missing after {start_mark}")
+    return text[start:end]
+
+
+class PairSentDeferredRosterTest(unittest.TestCase):
+    def test_pose_message_lists_sent_and_deferred_after_the_depth_stamp(self) -> None:
+        fields = message_fields(_read(POSE_MSG))
+        names = [name for _, name in fields]
+        self.assertEqual(
+            fields[-4:],
+            [
+                ("builtin_interfaces/Time", "input_rgb_stamp"),
+                ("builtin_interfaces/Time", "input_depth_stamp"),
+                ("int32", "stage2_source_index"),
+                ("int32[]", "deferred_source_indices"),
+            ],
+        )
+        self.assertEqual(names.count("stage2_source_index"), 1)
+        self.assertEqual(names.count("deferred_source_indices"), 1)
+        for kept in (
+            "header",
+            "pose",
+            "yaw_rad",
+            "face_normal_rgb",
+            "plane_inlier_ratio",
+            "n_face_points",
+            "chamfer_cost_m",
+            "accepted",
+            "quality_reasons",
+            "failure_reason",
+            "geometry_source",
+            "preset_id",
+        ):
+            self.assertIn(kept, names)
+
+    def test_other_class_matched_slots_stay_deferred_in_candidate_order(self) -> None:
+        chosen = make_sent_deferred_roster([0, 1, 2], 1)
+        self.assertEqual(chosen["stage2_source_index"], 1)
+        self.assertEqual(chosen["deferred_source_indices"], [0, 2])
+        self.assertEqual(make_sent_deferred_roster([2, 0, 5], 0)["deferred_source_indices"], [2, 5])
+        sent_zero = make_sent_deferred_roster([0, 3], 0)
+        self.assertEqual(sent_zero["stage2_source_index"], 0)
+        self.assertEqual(sent_zero["deferred_source_indices"], [3])
+        self.assertEqual(make_sent_deferred_roster([4], 4)["deferred_source_indices"], [])
+        self.assertEqual(make_sent_deferred_roster([1, 4], 1)["deferred_source_indices"], [4])
+
+    def test_tie_keeps_the_earlier_slot_sent(self) -> None:
+        body = function_body(_read(UTILS_CPP), "select_detection(")
+        self.assertIn("std::max_element", body)
+        self.assertIn("if (a.score != b.score) return a.score < b.score;", body)
+        self.assertIn("return a.area_px < b.area_px;", body)
+        self.assertNotIn("<=", body)
+        tied = make_sent_deferred_roster([1, 4], 1)
+        self.assertEqual(tied["stage2_source_index"], 1)
+        self.assertEqual(tied["deferred_source_indices"], [4])
+
+    def test_failure_diagnostic_uses_one_comma_separated_string(self) -> None:
+        self.assertEqual(format_deferred_source_indices([0, 2]), "0,2")
+        self.assertEqual(format_deferred_source_indices([2, 5]), "2,5")
+        self.assertEqual(format_deferred_source_indices([0]), "0")
+        self.assertEqual(format_deferred_source_indices([1, 10]), "1,10")
+        self.assertEqual(format_deferred_source_indices([]), "")
+
+    def test_success_writes_the_roster_on_the_pose_and_failure_writes_the_diagnostic(self) -> None:
+        cpp = _read(NODE_CPP)
+        hpp = _read(NODE_HPP)
+        on_pair = function_body(cpp, "PalletPoseNode::on_pair")
+        pose = function_body(cpp, "PalletPoseNode::publish_pose")
+        failure = function_body(cpp, "PalletPoseNode::publish_failure_diagnostics")
+        ok = function_body(cpp, "PalletPoseNode::publish_ok_diagnostics")
+
+        self.assertEqual(cpp.count("estimate_pose_chamfer_v3_2("), 1)
+        self.assertNotIn("for (", on_pair)
+        estimate_at = on_pair.find("estimate_pose_chamfer_v3_2(")
+        estimate_call = on_pair[estimate_at : on_pair.find(";", estimate_at)]
+        self.assertIn("candidate->bbox_xyxy", estimate_call)
+        self.assertIn("candidate->source_index", estimate_call)
+        self.assertNotIn("deferred", estimate_call)
+
+        empty_return = _between(on_pair, "if (!candidate.has_value())", "return;")
+        depth_return = _between(on_pair, "catch (", "return;")
+        for early in (empty_return, depth_return):
+            self.assertNotIn("publish_", early)
+            self.assertNotIn("make_sent_deferred_roster", early)
+        roster_at = on_pair.find("make_sent_deferred_roster(candidates, candidate->source_index)")
+        self.assertGreater(roster_at, 0)
+        self.assertGreater(roster_at, on_pair.find("return;", on_pair.find("catch (")))
+        self.assertLess(on_pair.find("select_detection("), roster_at)
+        self.assertLess(estimate_at, roster_at)
+        self.assertIn(
+            "publish_failure_diagnostics(outcome.failure, input_rgb_stamp, input_depth_stamp, roster)",
+            on_pair,
+        )
+        failure_call = on_pair.find("publish_failure_diagnostics(")
+        self.assertLess(on_pair.find("return;", failure_call), on_pair.find("publish_pose("))
+        self.assertIn(
+            "publish_pose(outcome.pose, outcome, frame_id, input_rgb_stamp, input_depth_stamp, roster)",
+            on_pair,
+        )
+        ok_call = _between(on_pair, "publish_ok_diagnostics(", ";")
+        self.assertNotIn("roster", ok_call)
+        self.assertNotIn("stage2_source_index", ok_call)
+
+        self.assertIn('#include "pps_pallet_pose_cpp/sent_deferred_roster.hpp"', hpp)
+        self.assertIn("const SentDeferredRoster& roster", hpp)
+        self.assertEqual(hpp.count("const SentDeferredRoster& roster"), 2)
+        ok_decl = hpp[hpp.find("void publish_ok_diagnostics(") : hpp.find(";", hpp.find("void publish_ok_diagnostics("))]
+        self.assertNotIn("roster", ok_decl)
+        self.assertNotIn("stage2_source_index", ok_decl)
+
+        self.assertIn("this->get_clock()->now()", pose)
+        self.assertIn("rich.header = ps.header;", pose)
+        self.assertIn("rich.input_rgb_stamp = input_rgb_stamp;", pose)
+        self.assertNotIn("rich.header.stamp = input_rgb_stamp", pose)
+        self.assertNotIn("rich.header.stamp = input_depth_stamp", pose)
+        depth_at = pose.find("rich.input_depth_stamp = input_depth_stamp;")
+        sent_at = pose.find("rich.stage2_source_index = roster.stage2_source_index;")
+        deferred_at = pose.find("rich.deferred_source_indices = roster.deferred_source_indices;")
+        publish_at = pose.find("rich_pub_->publish(rich);")
+        self.assertTrue(0 <= depth_at < sent_at < deferred_at < publish_at)
+        self.assertNotIn("if (roster.stage2_source_index", pose)
+        self.assertNotIn("format_deferred_source_indices", pose)
+
+        self.assertIn('status.name = "pps_pallet_pose_cpp"', failure)
+        self.assertIn('status.hardware_id = "dynamic_handling_ros_v1"', failure)
+        self.assertEqual(failure.count("DiagnosticStatus::WARN"), 1)
+        self.assertIn("status.message = failure.failure_reason", failure)
+        self.assertIn('kv.key = "failure_reason"', failure)
+        self.assertIn('rgb_kv.key = "input_rgb_stamp"', failure)
+        self.assertIn('depth_kv.key = "input_depth_stamp"', failure)
+        self.assertNotIn("if (!roster.deferred", failure)
+        self.assertNotIn("if (roster.stage2_source_index", failure)
+        self.assertIn('sent_kv.key = "stage2_source_index"', failure)
+        self.assertIn("sent_kv.value = std::to_string(roster.stage2_source_index)", failure)
+        self.assertIn('deferred_kv.key = "deferred_source_indices"', failure)
+        self.assertIn(
+            "deferred_kv.value = format_deferred_source_indices(roster.deferred_source_indices)",
+            failure,
+        )
+        self.assertEqual(failure.count('key = "deferred_source_indices"'), 1)
+        self.assertEqual(failure.count('key = "stage2_source_index"'), 1)
+        self.assertLess(
+            failure.find("status.values.push_back(deferred_kv)"),
+            failure.find("diag.status.push_back(status)"),
+        )
+        self.assertNotIn("rich_pub_", failure)
+        self.assertNotIn("PalletPoseStamped", failure)
+
+        self.assertNotIn("stage2_source_index", ok)
+        self.assertNotIn("deferred_source_indices", ok)
+        self.assertIn("DiagnosticStatus::OK", ok)
+        self.assertNotIn("estimate_pose", _read(ROSTER_HPP))
+
+
+if __name__ == "__main__":
+    unittest.main()
