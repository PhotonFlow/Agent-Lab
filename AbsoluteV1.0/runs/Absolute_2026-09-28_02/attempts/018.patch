diff --git a/geometry_core/test/test_inplace_chamfer_cost.py b/geometry_core/test/test_inplace_chamfer_cost.py
new file mode 100644
index 0000000..1107e43
--- /dev/null
+++ b/geometry_core/test/test_inplace_chamfer_cost.py
@@ -0,0 +1,134 @@
+"""Stage-2 cost samples the rotated contour plus this translation in place.
+
+chamfer_cost_from_rotated used to copy the rotated contour into tls.translated
+and then copy the sampled distances into tls.sorted before a full sort. The
+trimmed mean is still that ascending prefix. Translation is added to the
+rotated columns while sampling, and the distance buffer is sorted in place.
+"""
+
+from __future__ import annotations
+
+import math
+import unittest
+from pathlib import Path
+
+CHAMFER_CPP = Path(__file__).resolve().parents[1] / "src" / "chamfer.cpp"
+
+
+def function_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        raise AssertionError(f"{signature} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{signature} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{signature} body does not close")
+
+
+def bilinear_sample(
+    x: float,
+    y: float,
+    image: list[list[float]],
+    min_x: float,
+    min_y: float,
+    resolution_m: float,
+    penalty: float,
+) -> float:
+    """Same arithmetic as sample_bilinear_into, including an already-added translation."""
+    height = len(image)
+    width = len(image[0])
+    col_f = (x - min_x) / resolution_m
+    row_f = (y - min_y) / resolution_m
+    c0 = math.floor(col_f)
+    r0 = math.floor(row_f)
+    dx = col_f - float(c0)
+    dy = row_f - float(r0)
+    if r0 >= 0 and r0 + 1 < height and c0 >= 0 and c0 + 1 < width:
+        d00 = float(image[r0][c0])
+        d01 = float(image[r0][c0 + 1])
+        d10 = float(image[r0 + 1][c0])
+        d11 = float(image[r0 + 1][c0 + 1])
+        return (
+            (1.0 - dx) * (1.0 - dy) * d00
+            + dx * (1.0 - dy) * d01
+            + (1.0 - dx) * dy * d10
+            + dx * dy * d11
+        )
+    return penalty
+
+
+def trimmed_mean(distances: list[float], trim_fraction: float) -> float:
+    ordered = sorted(distances)
+    keep = len(ordered)
+    if trim_fraction > 0.0:
+        keep = max(1, math.ceil((1.0 - trim_fraction) * float(len(ordered))))
+    return sum(ordered[:keep]) / float(keep)
+
+
+class InplaceChamferCostTest(unittest.TestCase):
+    def test_translation_is_sampled_from_rotated_columns_and_distances_sort_in_place(self) -> None:
+        source = CHAMFER_CPP.read_text(encoding="utf-8")
+        cost = function_body(source, "chamfer_cost_from_rotated")
+        self.assertNotIn("tls.translated", cost)
+        self.assertNotIn("sample_bilinear_into", cost)
+        self.assertIn("sample_rotated_translation(", cost)
+        self.assertIn("trimmed_mean_from_distances(tls.distances, trim_fraction)", cost)
+
+        sample = function_body(source, "void sample_rotated_translation(")
+        self.assertNotIn("tls.translated", sample)
+        self.assertNotIn("setConstant", sample)
+        self.assertIn("rotated.data()", sample)
+        self.assertIn("rx[i] + tx", sample)
+        self.assertIn("ry[i] + ty", sample)
+        self.assertIn("std::floor(col_f)", sample)
+        self.assertIn("std::floor(row_f)", sample)
+        self.assertIn(
+            "(1.0 - dx) * (1.0 - dy) * d00 + dx * (1.0 - dy) * d01",
+            sample,
+        )
+        self.assertIn("+ (1.0 - dx) * dy * d10 + dx * dy * d11", sample)
+        self.assertIn("samples[i] = outside_penalty_m", sample)
+
+        trim = function_body(source, "trimmed_mean_from_distances")
+        self.assertNotIn("sorted.assign", trim)
+        self.assertNotIn("tls.sorted", trim)
+        self.assertIn("distances.data()", trim)
+        self.assertIn("std::sort(begin, begin + n)", trim)
+
+        image = [
+            [0.00, 0.04, 0.08],
+            [0.02, 0.05, 0.09],
+            [0.03, 0.06, 0.10],
+        ]
+        rotated = [(0.00, 0.00), (0.01, 0.00), (0.00, 0.01), (-0.02, 0.03)]
+        tx, ty = 0.02, -0.01
+        min_x, min_y, resolution_m, penalty = -0.05, -0.05, 0.01, 0.25
+        copied = [
+            bilinear_sample(x + tx, y + ty, image, min_x, min_y, resolution_m, penalty)
+            for x, y in rotated
+        ]
+        fused = [
+            bilinear_sample(x + tx, y + ty, image, min_x, min_y, resolution_m, penalty)
+            for x, y in rotated
+        ]
+        self.assertEqual(fused, copied)
+        self.assertEqual(trimmed_mean(fused, 0.10), sum(sorted(copied)) / 4.0)
+
+        samples = [0.2, 0.0, 0.05, 0.4, 0.01, 0.5, 0.03, 0.9, 0.02, 0.8]
+        # ceil(0.9 * 10) = 9. In-place sort and a copied sort share this prefix sum.
+        self.assertEqual(trimmed_mean(list(samples), 0.10), sum(sorted(samples)[:9]) / 9.0)
+        outside = [0.4, 0.25, 0.01]
+        self.assertEqual(trimmed_mean(outside, 0.10), sum(sorted(outside)[:3]) / 3.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
