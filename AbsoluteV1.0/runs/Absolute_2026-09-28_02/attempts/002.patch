+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+inline std::vector<int> deferred_source_indexes(
+    const std::vector<int>& candidate_source_indexes, int selected_source_index) {
+  std::vector<int> deferred;
+  for (int source_index : candidate_source_indexes) {
+    if (source_index != selected_source_index) {
+      deferred.push_back(source_index);
+    }
+  }
+  return deferred;
+}
+
+inline void append_deferred_detection_marks(
+    std::vector<std::pair<std::string, std::string>>& values, const std::vector<int>& deferred,
+    const std::string& input_rgb_stamp, const std::string& input_depth_stamp) {
+  values.emplace_back("input_rgb_stamp", input_rgb_stamp);
+  values.emplace_back("input_depth_stamp", input_depth_stamp);
+  for (int source_index : deferred) {
+    values.emplace_back("deferred_source_index", std::to_string(source_index));
+  }
+}
+
+}  // namespace pps_pallet_pose_cpp
