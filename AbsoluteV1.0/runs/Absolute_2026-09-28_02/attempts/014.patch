diff --git a/pps_pallet_pose_cpp/test/test_pair_capture_roster.py b/pps_pallet_pose_cpp/test/test_pair_capture_roster.py
new file mode 100644
index 0000000..bf91b3b
--- /dev/null
+++ b/pps_pallet_pose_cpp/test/test_pair_capture_roster.py
@@ -0,0 +1,303 @@
+"""Sent versus deferred slots for one synchronized detection and depth pair.
+
+Stage 2 runs once, on the class-matched candidate select_detection already
+chose. That candidate's Detection2DArray slot is stage2_source_index. The
+other class-matched slots stay deferred, in that same order. A score-and-area
+tie keeps the earlier slot, because select_detection uses std::max_element.
+Slot 0 is a real detection.
+
+A successful estimate writes both lists on PalletPoseStamped after this pair's
+depth stamp. The pose header stamp stays the publish time. A failed estimate
+publishes no PalletPoseStamped. The same two lists are two KeyValue entries on
+the existing WARN diagnostic: stage2_source_index as decimal text, and
+deferred_source_indices as one comma-separated string. An empty deferred list
+is an empty int32[] and an empty string. An empty candidate list and a
+depth-conversion exception publish nothing.
+"""
+
+from __future__ import annotations
+
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+PACKAGE_SRC = Path(__file__).resolve().parents[2]
+NODE_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "pallet_pose_node.cpp"
+NODE_HPP = (
+    PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "pallet_pose_node.hpp"
+)
+UTILS_HPP = (
+    PACKAGE_SRC
+    / "pps_pallet_pose_cpp"
+    / "include"
+    / "pps_pallet_pose_cpp"
+    / "detection_utils.hpp"
+)
+UTILS_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "detection_utils.cpp"
+POSE_MSG = PACKAGE_SRC / "pps_perception_msgs" / "msg" / "PalletPoseStamped.msg"
+
+# sent [deferred decimal]. Built by select_detection then pair_capture_roster.
+EXPECTED_LINES = [
+    "1 [0,2]",
+    "0 [2,5]",
+    "0 [3]",
+    "4 []",
+    "1 [4]",
+    "1 [10]",
+    "2 [5,0]",
+    "0 [3,8]",
+    "NONE",
+    "fmt []",
+    "fmt [0]",
+    "fmt [1,10]",
+]
+
+DRIVER = r"""
+#include "pps_pallet_pose_cpp/detection_utils.hpp"
+
+#include <iostream>
+#include <vector>
+
+pps_pallet_pose_cpp::DetectionCandidate cand(int slot, double score, double area) {
+  pps_pallet_pose_cpp::DetectionCandidate candidate;
+  candidate.bbox_xyxy = Eigen::Vector4d(0, 0, 1, 1);
+  candidate.score = score;
+  candidate.class_id = "pallet";
+  candidate.area_px = area;
+  candidate.source_index = slot;
+  return candidate;
+}
+
+void emit(const std::vector<pps_pallet_pose_cpp::DetectionCandidate>& candidates) {
+  auto chosen = pps_pallet_pose_cpp::select_detection(candidates, "highest_confidence");
+  if (!chosen.has_value()) {
+    std::cout << "NONE\n";
+    return;
+  }
+  std::vector<int> slots;
+  slots.reserve(candidates.size());
+  for (const auto& item : candidates) {
+    slots.push_back(item.source_index);
+  }
+  const auto roster = pps_pallet_pose_cpp::pair_capture_roster(slots, chosen->source_index);
+  std::cout << roster.stage2_source_index << " ["
+            << pps_pallet_pose_cpp::deferred_indices_decimal(roster.deferred_source_indices)
+            << "]\n";
+}
+
+int main() {
+  emit({cand(0, 0.2, 1.0), cand(1, 0.9, 1.0), cand(2, 0.4, 1.0)});
+  emit({cand(2, 0.4, 1.0), cand(0, 0.9, 1.0), cand(5, 0.1, 1.0)});
+  emit({cand(0, 0.5, 10.0), cand(3, 0.5, 10.0)});
+  emit({cand(4, 0.8, 1.0)});
+  emit({cand(1, 0.9, 1.0), cand(4, 0.2, 50.0)});
+  emit({cand(1, 0.95, 1.0), cand(10, 0.2, 1.0)});
+  emit({cand(5, 0.2, 1.0), cand(0, 0.3, 1.0), cand(2, 0.7, 1.0)});
+  emit({cand(0, 0.8, 1.0), cand(3, 0.2, 9.0), cand(8, 0.1, 9.0)});
+  emit({});
+  std::cout << "fmt [" << pps_pallet_pose_cpp::deferred_indices_decimal({}) << "]\n";
+  std::cout << "fmt [" << pps_pallet_pose_cpp::deferred_indices_decimal({0}) << "]\n";
+  std::cout << "fmt [" << pps_pallet_pose_cpp::deferred_indices_decimal({1, 10}) << "]\n";
+  return 0;
+}
+"""
+
+
+def _read(path: Path) -> str:
+    if not path.is_file():
+        raise AssertionError(f"{path.name} is missing")
+    return path.read_text(encoding="utf-8")
+
+
+def _wsl_path(path: Path) -> str:
+    text = path.resolve().as_posix()
+    if len(text) >= 2 and text[1] == ":":
+        return "/mnt/" + text[0].lower() + text[2:]
+    return text
+
+
+def _function_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        raise AssertionError(f"{signature} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{signature} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{signature} body does not close")
+
+
+def _message_fields(text: str) -> list[tuple[str, str]]:
+    fields = []
+    for raw in text.splitlines():
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        fields.append((parts[0], parts[1].split("=", 1)[0]))
+    return fields
+
+
+def _run_wsl(args: list[str]) -> subprocess.CompletedProcess[bytes]:
+    return subprocess.run(["wsl", "-e", *args], capture_output=True, check=False)
+
+
+def _ros_include_flags() -> list[str]:
+    listed = _run_wsl(
+        ["find", "/opt/ros/jazzy/include", "-mindepth", "1", "-maxdepth", "1", "-type", "d"]
+    )
+    if listed.returncode != 0:
+        detail = listed.stderr.decode("utf-8", errors="replace").strip()
+        raise AssertionError(detail or "could not list ROS include directories")
+    flags = ["-I/usr/include/eigen3"]
+    for raw in listed.stdout.decode("utf-8", errors="replace").splitlines():
+        directory = raw.strip()
+        if directory.startswith("/"):
+            flags.append(f"-I{directory}")
+    if len(flags) < 2:
+        raise AssertionError("ROS include directories were not found")
+    return flags
+
+
+def _run_roster_program() -> list[str]:
+    header = _read(UTILS_HPP)
+    if "pair_capture_roster" not in header or "deferred_indices_decimal" not in header:
+        raise AssertionError(
+            "detection_utils does not build the sent slot and the deferred slots"
+        )
+    include = UTILS_HPP.parent.parent
+    with tempfile.TemporaryDirectory(prefix="pair_capture_roster_") as tmp:
+        source = Path(tmp) / "drive_pair_capture_roster.cpp"
+        source.write_text(DRIVER, encoding="utf-8", newline="\n")
+        binary = "/tmp/drive_pair_capture_roster"
+        compiled = _run_wsl(
+            [
+                "g++",
+                "-std=c++17",
+                * _ros_include_flags(),
+                "-I",
+                _wsl_path(include),
+                _wsl_path(source),
+                _wsl_path(UTILS_CPP),
+                "-o",
+                binary,
+            ]
+        )
+        if compiled.returncode != 0:
+            detail = compiled.stderr.decode("utf-8", errors="replace").strip()
+            raise AssertionError(detail or "pair capture roster failed to compile")
+        ran = _run_wsl([binary])
+        if ran.returncode != 0:
+            detail = ran.stderr.decode("utf-8", errors="replace").strip()
+            raise AssertionError(detail or "pair capture roster program failed")
+        stdout = ran.stdout.decode("utf-8", errors="replace")
+    return [line for line in stdout.splitlines() if line.strip()]
+
+
+class PairCaptureRosterTest(unittest.TestCase):
+    def test_select_detection_split_keeps_tie_and_slot_zero(self) -> None:
+        self.assertEqual(_run_roster_program(), EXPECTED_LINES)
+
+    def test_pose_message_carries_sent_and_deferred_after_the_depth_stamp(self) -> None:
+        fields = _message_fields(_read(POSE_MSG))
+        names = [name for _kind, name in fields]
+        depth_at = names.index("input_depth_stamp")
+        self.assertEqual(
+            fields[depth_at + 1 : depth_at + 3],
+            [
+                ("int32", "stage2_source_index"),
+                ("int32[]", "deferred_source_indices"),
+            ],
+        )
+        self.assertEqual(names.count("stage2_source_index"), 1)
+        self.assertEqual(names.count("deferred_source_indices"), 1)
+
+    def test_success_path_writes_both_lists_on_the_rich_pose(self) -> None:
+        pose = _function_body(_read(NODE_CPP), "PalletPoseNode::publish_pose(")
+        depth_at = pose.find("rich.input_depth_stamp = input_depth_stamp;")
+        sent_at = pose.find("rich.stage2_source_index = roster.stage2_source_index;")
+        deferred_at = pose.find("roster.deferred_source_indices.begin()")
+        self.assertGreater(depth_at, -1)
+        self.assertGreater(sent_at, depth_at)
+        self.assertGreater(deferred_at, sent_at)
+        self.assertIn("rich.deferred_source_indices.assign(", pose)
+        self.assertIn("ps.header.stamp = stamp;", pose)
+        self.assertNotIn("estimate_pose_chamfer_v3_2", pose)
+        header = _read(NODE_HPP)
+        self.assertEqual(header.count("const PairCaptureRoster& roster"), 2)
+        ok_decl = header.find("void publish_ok_diagnostics(")
+        ok_end = header.find(";", ok_decl)
+        self.assertNotIn("PairCaptureRoster", header[ok_decl:ok_end])
+        self.assertIn('#include "pps_pallet_pose_cpp/detection_utils.hpp"', header)
+
+    def test_failure_diagnostic_carries_both_lists_and_publishes_no_pose(self) -> None:
+        failure = _function_body(_read(NODE_CPP), "PalletPoseNode::publish_failure_diagnostics(")
+        self.assertIn('status.name = "pps_pallet_pose_cpp"', failure)
+        self.assertIn('status.hardware_id = "dynamic_handling_ros_v1"', failure)
+        self.assertIn("DiagnosticStatus::WARN", failure)
+        self.assertIn("status.message = failure.failure_reason", failure)
+        self.assertIn('kv.key = "failure_reason"', failure)
+        self.assertIn('rgb_kv.key = "input_rgb_stamp"', failure)
+        self.assertIn('depth_kv.key = "input_depth_stamp"', failure)
+        self.assertIn('sent_kv.key = "stage2_source_index"', failure)
+        self.assertIn("sent_kv.value = std::to_string(roster.stage2_source_index)", failure)
+        self.assertIn('deferred_kv.key = "deferred_source_indices"', failure)
+        self.assertIn(
+            "deferred_kv.value = deferred_indices_decimal(roster.deferred_source_indices)",
+            failure,
+        )
+        self.assertEqual(failure.count('key = "deferred_source_indices"'), 1)
+        self.assertEqual(failure.count('key = "stage2_source_index"'), 1)
+        self.assertNotIn("rich_pub_", failure)
+        self.assertNotIn("PalletPoseStamped", failure)
+
+    def test_pair_runs_stage2_once_and_publishes_nothing_on_the_early_returns(self) -> None:
+        source = _read(NODE_CPP)
+        pair = _function_body(source, "PalletPoseNode::on_pair(")
+        self.assertEqual(pair.count("estimate_pose_chamfer_v3_2("), 1)
+        self.assertEqual(source.count("estimate_pose_chamfer_v3_2("), 1)
+        roster_at = pair.find("pair_capture_roster(class_matched_slots, candidate->source_index)")
+        self.assertGreater(roster_at, -1)
+        self.assertIn("matched.source_index", pair)
+        self.assertEqual(pair.count("select_detection("), 1)
+        empty_at = pair.find("if (!candidate.has_value())")
+        empty_return = pair.find("return;", empty_at)
+        self.assertLess(empty_return, pair.find("depth_image_to_meters"))
+        self.assertLess(empty_return, roster_at)
+        catch_at = pair.find("catch (const std::exception&")
+        catch_return = pair.find("return;", catch_at)
+        estimate_at = pair.find("estimate_pose_chamfer_v3_2(")
+        self.assertLess(catch_return, roster_at)
+        self.assertLess(roster_at, estimate_at)
+        estimate_end = pair.find(");", estimate_at)
+        self.assertIn("candidate->source_index", pair[estimate_at:estimate_end])
+        self.assertIn(
+            "publish_failure_diagnostics(outcome.failure, input_rgb_stamp, input_depth_stamp, roster)",
+            pair,
+        )
+        self.assertIn(
+            "publish_pose(outcome.pose, outcome, frame_id, input_rgb_stamp, input_depth_stamp, roster)",
+            pair,
+        )
+        ok_call = pair.find("publish_ok_diagnostics(")
+        ok_end = pair.find(";", ok_call)
+        self.assertNotIn("roster", pair[ok_call:ok_end])
+        ok = _function_body(source, "PalletPoseNode::publish_ok_diagnostics(")
+        self.assertNotIn("stage2_source_index", ok)
+        self.assertNotIn("deferred_source_indices", ok)
+        self.assertNotIn("deferred_indices_decimal", ok)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/pps_perception_msgs/msg/PalletPoseStamped.msg b/pps_perception_msgs/msg/PalletPoseStamped.msg
index 73a44bb..afd10f2 100644
