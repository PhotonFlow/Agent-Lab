+++ b/pps_perception_msgs/msg/PalletPoseStamped.msg
@@ -37,3 +37,9 @@ string preset_id
 # above is the publish time).
 builtin_interfaces/Time input_rgb_stamp
 builtin_interfaces/Time input_depth_stamp
+
+# Detection2DArray slot of the one class-matched candidate sent through
+# stage 2 for this capture. Slot 0 is a real detection. The other
+# class-matched slots from this same array are deferred and are not posed.
+int32 stage2_source_index
+int32[] deferred_source_indices
