+    def test_failure_diagnostic_writes_both_lists_and_no_pose(self) -> None:
+        source = NODE_CPP.read_text(encoding="utf-8")
+        failure = function_body(source, "PalletPoseNode::publish_failure_diagnostics(")
+        self.assertIn('status.name = "pps_pallet_pose_cpp";', failure)
+        self.assertIn('status.hardware_id = "dynamic_handling_ros_v1";', failure)
+        self.assertIn("DiagnosticStatus::WARN", failure)
+        self.assertIn("status.message = failure.failure_reason;", failure)
+        self.assertIn('kv.key = "failure_reason";', failure)
+        self.assertIn('rgb_kv.key = "input_rgb_stamp";', failure)
+        self.assertIn('depth_kv.key = "input_depth_stamp";', failure)
+        assert_in_order(
+            failure,
+            [
+                'depth_kv.key = "input_depth_stamp";',
+                'admitted_kv.key = "admitted_source_index";',
+                "admitted_kv.value = std::to_string(admission.admitted.front().source_index);",
+                'deferred_kv.key = "deferred_source_indices";',
+                "deferred_kv.value = deferred_source_indices_text(admission.deferred);",
+            ],
+        )
+        self.assertEqual(failure.count('deferred_kv.key = "deferred_source_indices";'), 1)
+        self.assertEqual(failure.count('admitted_kv.key = "admitted_source_index";'), 1)
