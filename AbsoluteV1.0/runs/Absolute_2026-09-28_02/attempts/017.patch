+                "rich.admitted_source_index = admission.admitted.front().source_index;",
+                "for (const DetectionCandidate& deferred_candidate : admission.deferred)",
+                "rich.deferred_source_indices.push_back(deferred_candidate.source_index);",
+                "rich_pub_->publish(rich);",
