diff --git a/pps_pallet_pose_cpp/test/test_published_admission_split.py b/pps_pallet_pose_cpp/test/test_published_admission_split.py
new file mode 100644
index 0000000..640e8e0
--- /dev/null
+++ b/pps_pallet_pose_cpp/test/test_published_admission_split.py
@@ -0,0 +1,458 @@
+"""Admission split for one synchronized capture.
+
+select_stage2_subset ranks class-matched DetectionCandidate values with the
+same strict-weak ordering select_detection uses. std::max_element keeps the
+first maximum, so a tie on both keys leaves the later candidate deferred.
+Admitted candidates are that rank order, at most the caller's count. Deferred
+candidates stay in candidate-list order and keep source_index.
+
+The pose node calls it with detection_selection and a count of one, estimates
+that one pallet, and writes admitted_source_index plus deferred_source_indices
+on PalletPoseStamped after input_depth_stamp. A failed estimate publishes no
+pose and writes those same lists on the WARN diagnostic.
+"""
+
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+PACKAGE_SRC = Path(__file__).resolve().parents[2]
+NODE_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "pallet_pose_node.cpp"
+NODE_HPP = (
+    PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "pallet_pose_node.hpp"
+)
+UTILS_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "detection_utils.cpp"
+UTILS_HPP = (
+    PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "detection_utils.hpp"
+)
+POSE_MSG = PACKAGE_SRC / "pps_perception_msgs" / "msg" / "PalletPoseStamped.msg"
+
+POSE_FIELDS = [
+    ("std_msgs/Header", "header"),
+    ("geometry_msgs/Pose", "pose"),
+    ("float64", "yaw_rad"),
+    ("float64[3]", "face_normal_rgb"),
+    ("float64", "plane_inlier_ratio"),
+    ("int32", "n_face_points"),
+    ("float64", "chamfer_cost_m"),
+    ("bool", "accepted"),
+    ("string[]", "quality_reasons"),
+    ("string", "failure_reason"),
+    ("string", "geometry_source"),
+    ("string", "preset_id"),
+    ("builtin_interfaces/Time", "input_rgb_stamp"),
+    ("builtin_interfaces/Time", "input_depth_stamp"),
+    ("int32", "admitted_source_index"),
+    ("int32[]", "deferred_source_indices"),
+]
+
+
+def function_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        raise AssertionError(f"{signature} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{signature} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{signature} body does not close")
+
+
+def message_fields(text: str) -> list[tuple[str, str]]:
+    fields = []
+    for raw in text.splitlines():
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        fields.append((parts[0], parts[1].split("=", 1)[0]))
+    return fields
+
+
+def assert_in_order(text: str, markers: list[str]) -> None:
+    cursor = 0
+    for marker in markers:
+        found = text.find(marker, cursor)
+        if found < 0:
+            raise AssertionError(f"{marker!r} is missing after position {cursor}")
+        cursor = found + len(marker)
+
+
+def compile_less(body: str, primary: str, secondary: str):
+    normalized = " ".join(body.split())
+    expected = (
+        f"if (a.{primary} != b.{primary}) {{ return a.{primary} < b.{primary}; }} "
+        f"return a.{secondary} < b.{secondary};"
+    )
+    if normalized != expected:
+        raise AssertionError(
+            f"comparator is not strict < on {primary} then {secondary}: {normalized}"
+        )
+    if "<=" in body or "source_index" in body:
+        raise AssertionError("comparator is not a strict weak ordering of the two keys")
+
+    def less(left: dict, right: dict) -> bool:
+        if left[primary] != right[primary]:
+            return left[primary] < right[primary]
+        return left[secondary] < right[secondary]
+
+    return less
+
+
+def first_maximum(candidates: list[dict], less) -> int:
+    """std::max_element: replace the champion only when it is strictly less."""
+    best = 0
+    for index in range(1, len(candidates)):
+        if less(candidates[best], candidates[index]):
+            best = index
+    return best
+
+
+def admit(candidates: list[dict], less, count: int) -> tuple[list[dict], list[dict]]:
+    """First-maximum admission. Empty input yields two empty vectors."""
+    if not candidates:
+        return [], []
+    chosen = [False] * len(candidates)
+    admitted: list[dict] = []
+    limit = count if count > 0 else 0
+    for _ in range(limit):
+        open_indexes = [index for index, taken in enumerate(chosen) if not taken]
+        if not open_indexes:
+            break
+        best_local = 0
+        for local in range(1, len(open_indexes)):
+            if less(candidates[open_indexes[best_local]], candidates[open_indexes[local]]):
+                best_local = local
+        chosen[open_indexes[best_local]] = True
+        admitted.append(candidates[open_indexes[best_local]])
+    deferred = [candidates[index] for index, taken in enumerate(chosen) if not taken]
+    return admitted, deferred
+
+
+def source_indexes(candidates: list[dict]) -> list[int]:
+    return [candidate["source_index"] for candidate in candidates]
+
+
+def box(score: float, area_px: float, source_index: int) -> dict:
+    return {"score": score, "area_px": area_px, "source_index": source_index}
+
+
+class PublishedAdmissionSplitTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.utils_cpp = UTILS_CPP.read_text(encoding="utf-8")
+        self.utils_hpp = UTILS_HPP.read_text(encoding="utf-8")
+        self.highest = compile_less(
+            function_body(self.utils_cpp, "bool less_highest_confidence("),
+            "score",
+            "area_px",
+        )
+        self.largest = compile_less(
+            function_body(self.utils_cpp, "bool less_largest_area("),
+            "area_px",
+            "score",
+        )
+
+    def test_select_detection_uses_those_same_comparators(self) -> None:
+        body = function_body(self.utils_cpp, "select_detection(")
+        assert_in_order(
+            body,
+            [
+                "if (candidates.empty())",
+                "return std::nullopt;",
+                "less_highest_confidence",
+                "less_largest_area",
+                "throw std::invalid_argument",
+            ],
+        )
+        self.assertIn("std::max_element", body)
+        self.assertNotIn("<=", body)
+
+    def test_empty_candidates_return_before_strategy_and_max_element(self) -> None:
+        self.assertIn("struct Stage2Admission", self.utils_hpp)
+        self.assertIn("std::vector<DetectionCandidate> admitted", self.utils_hpp)
+        self.assertIn("std::vector<DetectionCandidate> deferred", self.utils_hpp)
+        declaration = function_body(self.utils_hpp, "struct Stage2Admission")
+        self.assertIn("admitted", declaration)
+        self.assertIn("deferred", declaration)
+        body = function_body(self.utils_cpp, "select_stage2_subset(")
+        assert_in_order(
+            body,
+            [
+                "if (candidates.empty())",
+                "return admission;",
+                '"highest_confidence"',
+                '"largest_area"',
+                "throw std::invalid_argument",
+                "std::max_element",
+            ],
+        )
+        self.assertNotIn("stable_sort", body)
+        self.assertNotIn("partial_sort", body)
+        self.assertNotIn("stable_partition", body)
+        self.assertNotIn("source_index", body)
+        self.assertNotIn("<=", body)
+        admitted, deferred = admit([], self.highest, 1)
+        self.assertEqual(admitted, [])
+        self.assertEqual(deferred, [])
+
+    def test_highest_confidence_keeps_the_first_maximum(self) -> None:
+        higher_score = [box(0.2, 100.0, 0), box(0.8, 10.0, 3)]
+        admitted, deferred = admit(higher_score, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [3])
+        self.assertEqual(source_indexes(deferred), [0])
+
+        larger_area = [box(0.5, 10.0, 1), box(0.5, 40.0, 4)]
+        admitted, deferred = admit(larger_area, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [4])
+        self.assertEqual(source_indexes(deferred), [1])
+
+        full_tie = [box(0.5, 10.0, 2), box(0.5, 10.0, 7)]
+        admitted, deferred = admit(full_tie, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [2])
+        self.assertEqual(source_indexes(deferred), [7])
+        self.assertEqual(first_maximum(full_tie, self.highest), 0)
+
+        index_is_not_a_key = [box(0.4, 8.0, 9), box(0.4, 8.0, 0)]
+        admitted, deferred = admit(index_is_not_a_key, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [9])
+        self.assertEqual(source_indexes(deferred), [0])
+
+    def test_largest_area_reverses_the_key_order(self) -> None:
+        larger_area = [box(0.9, 5.0, 0), box(0.1, 50.0, 1)]
+        admitted, deferred = admit(larger_area, self.largest, 1)
+        self.assertEqual(source_indexes(admitted), [1])
+        self.assertEqual(source_indexes(deferred), [0])
+
+        higher_score = [box(0.2, 30.0, 0), box(0.8, 30.0, 5)]
+        admitted, deferred = admit(higher_score, self.largest, 1)
+        self.assertEqual(source_indexes(admitted), [5])
+        self.assertEqual(source_indexes(deferred), [0])
+
+        full_tie = [box(0.4, 12.0, 3), box(0.4, 12.0, 8)]
+        admitted, deferred = admit(full_tie, self.largest, 1)
+        self.assertEqual(source_indexes(admitted), [3])
+        self.assertEqual(source_indexes(deferred), [8])
+
+    def test_count_admits_in_rank_order_and_defers_in_list_order(self) -> None:
+        candidates = [
+            box(0.2, 1.0, 0),
+            box(0.9, 1.0, 2),
+            box(0.5, 1.0, 6),
+            box(0.9, 50.0, 7),
+        ]
+        admitted, deferred = admit(candidates, self.highest, 2)
+        self.assertEqual(source_indexes(admitted), [7, 2])
+        self.assertEqual(source_indexes(deferred), [0, 6])
+
+        admitted, deferred = admit(candidates, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [source_indexes(candidates)[first_maximum(candidates, self.highest)]])
+        self.assertEqual(admitted[0]["source_index"], 7)
+
+        admitted, deferred = admit(candidates, self.highest, 5)
+        self.assertEqual(source_indexes(admitted), [7, 2, 6, 0])
+        self.assertEqual(deferred, [])
+
+        admitted, deferred = admit(candidates, self.highest, 0)
+        self.assertEqual(admitted, [])
+        self.assertEqual(source_indexes(deferred), [0, 2, 6, 7])
+
+        areas = [
+            box(0.9, 10.0, 1),
+            box(0.2, 40.0, 4),
+            box(0.8, 40.0, 5),
+            box(0.1, 10.0, 8),
+        ]
+        admitted, deferred = admit(areas, self.largest, 2)
+        self.assertEqual(source_indexes(admitted), [5, 4])
+        self.assertEqual(source_indexes(deferred), [1, 8])
+
+    def test_tie_on_both_keys_defers_the_later_candidate_in_list_order(self) -> None:
+        tied = [box(0.7, 3.0, 0), box(0.7, 5.0, 1), box(0.7, 5.0, 2)]
+        admitted, deferred = admit(tied, self.highest, 1)
+        self.assertEqual(source_indexes(admitted), [1])
+        self.assertEqual(source_indexes(deferred), [0, 2])
+        admitted, deferred = admit(tied, self.highest, 2)
+        self.assertEqual(source_indexes(admitted), [1, 2])
+        self.assertEqual(source_indexes(deferred), [0])
