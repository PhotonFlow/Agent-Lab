+    def test_deferred_diagnostic_text_is_one_comma_separated_string(self) -> None:
+        body = function_body(self.utils_cpp, "deferred_source_indices_text(")
+        normalized = " ".join(body.split())
+        expected = (
+            "std::string text; "
+            "for (std::size_t index = 0; index < deferred.size(); ++index) { "
+            "if (index != 0) { text.push_back(','); } "
+            "text += std::to_string(deferred[index].source_index); } "
+            "return text;"
+        )
+        self.assertEqual(normalized, expected)
+
+        def deferred_text(source_indexes_in_order: list[int]) -> str:
+            text = ""
+            for index, source_index in enumerate(source_indexes_in_order):
+                if index != 0:
+                    text += ","
+                text += str(source_index)
+            return text
+
+        self.assertEqual(deferred_text([]), "")
+        self.assertEqual(deferred_text([0]), "0")
+        self.assertEqual(deferred_text([4, 8]), "4,8")
+        self.assertEqual(deferred_text([1, 10]), "1,10")
