+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+struct DeferredDetectionStatus {
+  std::string name;
+  std::string hardware_id;
+  std::string message;
+  int level = 0;
+  std::vector<std::pair<std::string, std::string>> values;
+};
+
+inline std::vector<DeferredDetectionStatus> deferred_detection_statuses(
+    const std::vector<int>& candidate_source_indexes, int selected_source_index,
+    const std::string& input_rgb_stamp, const std::string& input_depth_stamp) {
+  std::vector<DeferredDetectionStatus> statuses;
+  for (int source_index : candidate_source_indexes) {
+    if (source_index == selected_source_index) {
+      continue;
+    }
+    DeferredDetectionStatus status;
+    status.name = "pps_pallet_pose_cpp";
+    status.hardware_id = "dynamic_handling_ros_v1";
+    status.message = "deferred";
+    status.level = 0;
+    status.values.push_back({"source_index", std::to_string(source_index)});
+    status.values.push_back({"input_rgb_stamp", input_rgb_stamp});
+    status.values.push_back({"input_depth_stamp", input_depth_stamp});
+    statuses.push_back(status);
+  }
+  return statuses;
+}
+
+}  // namespace pps_pallet_pose_cpp
