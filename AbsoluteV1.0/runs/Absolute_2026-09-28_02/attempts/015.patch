@@ -0,0 +1,42 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// This synchronized capture. stage2_source_index is the Detection2DArray slot
+// select_detection already chose. The other class-matched slots stay deferred,
+// in that same order. Slot 0 is a real detection.
+struct ClassMatchedSplit {
+  int stage2_source_index = 0;
+  std::vector<int> deferred_source_indices;
+};
+
+inline ClassMatchedSplit class_matched_split(const std::vector<int>& class_matched_slots,
+                                             int sent_slot) {
+  ClassMatchedSplit split;
+  split.stage2_source_index = sent_slot;
+  split.deferred_source_indices.reserve(class_matched_slots.size());
+  for (int slot : class_matched_slots) {
+    if (slot == sent_slot) {
+      continue;
+    }
+    split.deferred_source_indices.push_back(slot);
+  }
+  return split;
+}
+
+// One diagnostic value. An empty deferred list is an empty string.
+inline std::string decimal_deferred_slots(const std::vector<int>& deferred_source_indices) {
+  std::string text;
+  for (std::size_t index = 0; index < deferred_source_indices.size(); ++index) {
+    if (index != 0) {
+      text.push_back(',');
+    }
+    text += std::to_string(deferred_source_indices[index]);
+  }
+  return text;
+}
+
+}  // namespace pps_pallet_pose_cpp
