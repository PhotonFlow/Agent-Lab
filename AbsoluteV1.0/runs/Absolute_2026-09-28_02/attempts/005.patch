+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// Source indexes select_detection did not choose, in candidate order, as one
+// diagnostic value. Empty when that selected pallet is the only candidate.
+inline std::string format_deferred_source_indexes(
+    const std::vector<int>& candidate_source_indexes, int selected_source_index) {
+  std::string joined;
+  for (int source_index : candidate_source_indexes) {
+    if (source_index == selected_source_index) {
+      continue;
+    }
+    if (!joined.empty()) {
+      joined.push_back(',');
+    }
+    joined += std::to_string(source_index);
+  }
+  return joined;
+}
+
+}  // namespace pps_pallet_pose_cpp
