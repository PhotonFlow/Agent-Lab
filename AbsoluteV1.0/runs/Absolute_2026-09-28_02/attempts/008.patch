+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// Slots in this synchronized Detection2DArray. stage2_source_index is the
+// class-matched candidate select_detection sent through stage 2. The other
+// class-matched slots stay in candidate order and are not posed.
+struct CaptureRoster {
+  int stage2_source_index = 0;
+  std::vector<int> deferred_source_indices;
+};
+
+inline CaptureRoster capture_roster(const std::vector<int>& class_matched_slots, int sent_slot) {
+  CaptureRoster roster;
+  roster.stage2_source_index = sent_slot;
+  for (int slot : class_matched_slots) {
+    if (slot == sent_slot) {
+      continue;
+    }
+    roster.deferred_source_indices.push_back(slot);
+  }
+  return roster;
+}
+
+// One diagnostic value. Empty when this pair had one class-matched candidate.
+inline std::string deferred_indices_decimal(const std::vector<int>& deferred_source_indices) {
+  std::string text;
+  for (int slot : deferred_source_indices) {
+    if (!text.empty()) {
+      text.push_back(',');
+    }
+    text += std::to_string(slot);
+  }
+  return text;
+}
+
+}  // namespace pps_pallet_pose_cpp
