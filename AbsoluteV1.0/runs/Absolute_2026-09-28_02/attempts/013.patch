+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// Slots in this synchronized Detection2DArray. stage2_source_index is the
+// class-matched candidate select_detection already chose. The other
+// class-matched slots stay deferred, in that same order. Slot 0 is real.
+struct CaptureSlotSplit {
+  int stage2_source_index = 0;
+  std::vector<int> deferred_source_indices;
+};
+
+inline CaptureSlotSplit split_class_matched_slots(const std::vector<int>& class_matched_slots,
+                                                   int sent_slot) {
+  CaptureSlotSplit capture;
+  capture.stage2_source_index = sent_slot;
+  for (int slot : class_matched_slots) {
+    if (slot == sent_slot) {
+      continue;
+    }
+    capture.deferred_source_indices.push_back(slot);
+  }
+  return capture;
+}
+
+// One diagnostic KeyValue holds one string. An empty deferred list is empty text.
+inline std::string join_deferred_slots(const std::vector<int>& deferred_source_indices) {
+  std::string text;
+  for (std::size_t index = 0; index < deferred_source_indices.size(); ++index) {
+    if (index != 0) {
+      text.push_back(',');
+    }
+    text += std::to_string(deferred_source_indices[index]);
+  }
+  return text;
+}
+
+}  // namespace pps_pallet_pose_cpp
