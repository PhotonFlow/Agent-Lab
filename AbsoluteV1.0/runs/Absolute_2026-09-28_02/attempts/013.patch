diff --git a/pps_pallet_pose_cpp/test/test_capture_slot_split.py b/pps_pallet_pose_cpp/test/test_capture_slot_split.py
new file mode 100644
index 0000000..9fbc76e
--- /dev/null
+++ b/pps_pallet_pose_cpp/test/test_capture_slot_split.py
@@ -0,0 +1,252 @@
+"""Sent versus deferred Detection2DArray slots for one synchronized pair.
+
+Stage 2 runs once, on the class-matched candidate select_detection already
+chose. That slot is stage2_source_index. The other class-matched slots stay
+deferred, in Detection2DArray order. A score tie stays with the earlier slot
+because select_detection uses std::max_element. Slot 0 is a real detection.
+
+A successful estimate writes both lists on PalletPoseStamped after this
+pair's depth stamp. A failed estimate publishes no PalletPoseStamped. The
+same two lists are two KeyValue entries on the existing WARN diagnostic.
+An empty deferred list is an empty int32[] and an empty diagnostic string.
+An empty candidate list and a depth-conversion exception publish nothing.
+"""
+
+from __future__ import annotations
+
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+PACKAGE_SRC = Path(__file__).resolve().parents[2]
+NODE_CPP = PACKAGE_SRC / "pps_pallet_pose_cpp" / "src" / "pallet_pose_node.cpp"
+NODE_HPP = (
+    PACKAGE_SRC / "pps_pallet_pose_cpp" / "include" / "pps_pallet_pose_cpp" / "pallet_pose_node.hpp"
+)
+SPLIT_HPP = (
+    PACKAGE_SRC
+    / "pps_pallet_pose_cpp"
+    / "include"
+    / "pps_pallet_pose_cpp"
+    / "capture_slot_split.hpp"
+)
+POSE_MSG = PACKAGE_SRC / "pps_perception_msgs" / "msg" / "PalletPoseStamped.msg"
+
+# sent [deferred decimal]. Slot 0 is sent for real. Empty brackets are an
+# empty deferred list. Order is the class-matched Detection2DArray order.
+EXPECTED_LINES = [
+    "1 [0,2]",
+    "0 [2,5]",
+    "0 [3]",
+    "4 []",
+    "1 [4]",
+    "1 [10]",
+    "2 [5,0]",
+    "0 [3,8]",
+]
+
+
+def _read(path: Path) -> str:
+    if not path.is_file():
+        raise AssertionError(f"{path.name} is missing")
+    return path.read_text(encoding="utf-8")
+
+
+def _wsl_path(path: Path) -> str:
+    text = path.resolve().as_posix()
+    if len(text) >= 2 and text[1] == ":":
+        return "/mnt/" + text[0].lower() + text[2:]
+    return text
+
+
+def _function_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        raise AssertionError(f"{signature} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{signature} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{signature} body does not close")
+
+
+def _message_fields(text: str) -> list[tuple[str, str]]:
+    fields = []
+    for raw in text.splitlines():
+        line = raw.split("#", 1)[0].strip()
+        if not line:
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        fields.append((parts[0], parts[1].split("=", 1)[0]))
+    return fields
+
+
+def _run_split_program() -> list[str]:
+    header = _read(SPLIT_HPP)
+    if "split_class_matched_slots" not in header or "join_deferred_slots" not in header:
+        raise AssertionError("capture slot split does not expose sent and deferred slots")
+    driver = r"""
+#include "pps_pallet_pose_cpp/capture_slot_split.hpp"
+
+#include <iostream>
+#include <vector>
+
+int main() {
+  using pps_pallet_pose_cpp::join_deferred_slots;
+  using pps_pallet_pose_cpp::split_class_matched_slots;
+  const std::vector<std::vector<int>> slots = {
+      {0, 1, 2}, {2, 0, 5}, {0, 3}, {4}, {1, 4}, {1, 10}, {5, 0, 2}, {0, 3, 8},
+  };
+  const int sent[] = {1, 0, 0, 4, 1, 1, 2, 0};
+  for (std::size_t i = 0; i < slots.size(); ++i) {
+    const auto capture = split_class_matched_slots(slots[i], sent[i]);
+    std::cout << capture.stage2_source_index << " ["
+              << join_deferred_slots(capture.deferred_source_indices) << "]\n";
+  }
+  return 0;
+}
+"""
+    include = SPLIT_HPP.parent.parent
+    with tempfile.TemporaryDirectory(prefix="capture_slot_split_") as tmp:
+        source = Path(tmp) / "drive_capture_slot_split.cpp"
+        source.write_text(driver, encoding="utf-8", newline="\n")
+        binary = "/tmp/drive_capture_slot_split"
+        compiled = subprocess.run(
+            [
+                "wsl",
+                "-e",
+                "g++",
+                "-std=c++17",
+                "-I",
+                _wsl_path(include),
+                _wsl_path(source),
+                "-o",
+                binary,
+            ],
+            capture_output=True,
+            check=False,
+        )
+        if compiled.returncode != 0:
+            detail = compiled.stderr.decode("utf-8", errors="replace").strip()
+            raise AssertionError(detail or "capture slot split failed to compile")
+        ran = subprocess.run(
+            ["wsl", "-e", binary],
+            capture_output=True,
+            check=False,
+        )
+        if ran.returncode != 0:
+            detail = ran.stderr.decode("utf-8", errors="replace").strip()
+            raise AssertionError(detail or "capture slot split program failed")
+        stdout = ran.stdout.decode("utf-8", errors="replace")
+    return [line for line in stdout.splitlines() if line.strip()]
+
+
+class CaptureSlotSplitTest(unittest.TestCase):
+    def test_deferred_slots_keep_detection_order_except_the_sent_slot(self) -> None:
+        self.assertEqual(_run_split_program(), EXPECTED_LINES)
+
+    def test_pose_message_carries_sent_and_deferred_after_the_depth_stamp(self) -> None:
+        fields = _message_fields(_read(POSE_MSG))
+        names = [name for _kind, name in fields]
+        depth_at = names.index("input_depth_stamp")
+        self.assertEqual(
+            fields[depth_at + 1 : depth_at + 3],
+            [
+                ("int32", "stage2_source_index"),
+                ("int32[]", "deferred_source_indices"),
+            ],
+        )
+        self.assertEqual(names.count("stage2_source_index"), 1)
+        self.assertEqual(names.count("deferred_source_indices"), 1)
+
+    def test_success_path_writes_both_lists_on_the_rich_pose(self) -> None:
+        pose = _function_body(
+            _read(NODE_CPP),
+            "PalletPoseNode::publish_pose(",
+        )
+        depth_at = pose.find("rich.input_depth_stamp = input_depth_stamp;")
+        sent_at = pose.find("rich.stage2_source_index = capture_slots.stage2_source_index;")
+        deferred_at = pose.find("capture_slots.deferred_source_indices.begin()")
+        self.assertGreater(depth_at, -1)
+        self.assertGreater(sent_at, depth_at)
+        self.assertGreater(deferred_at, sent_at)
+        self.assertIn("rich.deferred_source_indices.assign(", pose)
+        self.assertIn("ps.header.stamp = stamp;", pose)
+        self.assertNotIn("estimate_pose_chamfer_v3_2", pose)
+        header = _read(NODE_HPP)
+        self.assertIn("const CaptureSlotSplit& capture_slots", header)
+        self.assertIn("capture_slot_split.hpp", header)
+
+    def test_failure_diagnostic_carries_both_lists_and_publishes_no_pose(self) -> None:
+        failure = _function_body(
+            _read(NODE_CPP),
+            "PalletPoseNode::publish_failure_diagnostics(",
+        )
+        self.assertIn('status.name = "pps_pallet_pose_cpp"', failure)
+        self.assertIn('status.hardware_id = "dynamic_handling_ros_v1"', failure)
+        self.assertIn("DiagnosticStatus::WARN", failure)
+        self.assertIn("status.message = failure.failure_reason", failure)
+        self.assertIn('kv.key = "failure_reason"', failure)
+        self.assertIn('rgb_kv.key = "input_rgb_stamp"', failure)
+        self.assertIn('depth_kv.key = "input_depth_stamp"', failure)
+        self.assertIn('sent_kv.key = "stage2_source_index"', failure)
+        self.assertIn(
+            "sent_kv.value = std::to_string(capture_slots.stage2_source_index)",
+            failure,
+        )
+        self.assertIn('deferred_kv.key = "deferred_source_indices"', failure)
+        self.assertIn(
+            "deferred_kv.value = join_deferred_slots(capture_slots.deferred_source_indices)",
+            failure,
+        )
+        self.assertEqual(failure.count('key = "deferred_source_indices"'), 1)
+        self.assertEqual(failure.count('key = "stage2_source_index"'), 1)
+        self.assertNotIn("rich_pub_", failure)
+        self.assertNotIn("PalletPoseStamped", failure)
+
+    def test_pair_runs_stage2_once_and_publishes_nothing_on_the_early_returns(self) -> None:
+        source = _read(NODE_CPP)
+        pair = _function_body(source, "PalletPoseNode::on_pair(")
+        self.assertEqual(pair.count("estimate_pose_chamfer_v3_2("), 1)
+        self.assertEqual(source.count("estimate_pose_chamfer_v3_2("), 1)
+        self.assertIn(
+            "split_class_matched_slots(class_matched_slots, candidate->source_index)",
+            pair,
+        )
+        self.assertIn("matched.source_index", pair)
+        self.assertEqual(pair.count("select_detection("), 1)
+        self.assertIn("if (!candidate.has_value())", pair)
+        empty_at = pair.find("if (!candidate.has_value())")
+        empty_return = pair.find("return;", empty_at)
+        self.assertLess(empty_return, pair.find("depth_image_to_meters"))
+        self.assertLess(pair.find("catch (const std::exception&"), pair.find("estimate_pose_chamfer_v3_2("))
+        catch_at = pair.find("catch (const std::exception&")
+        catch_return = pair.find("return;", catch_at)
+        self.assertLess(catch_return, pair.find("estimate_pose_chamfer_v3_2("))
+        self.assertIn(
+            "publish_failure_diagnostics(outcome.failure, input_rgb_stamp, input_depth_stamp, capture_slots)",
+            pair,
+        )
+        self.assertIn(
+            "publish_pose(outcome.pose, outcome, frame_id, input_rgb_stamp, input_depth_stamp, capture_slots)",
+            pair,
+        )
+        ok = _function_body(source, "PalletPoseNode::publish_ok_diagnostics(")
+        self.assertNotIn("stage2_source_index", ok)
+        self.assertNotIn("deferred_source_indices", ok)
+        self.assertNotIn("join_deferred_slots", ok)
+
+
+if __name__ == "__main__":
+    unittest.main()
