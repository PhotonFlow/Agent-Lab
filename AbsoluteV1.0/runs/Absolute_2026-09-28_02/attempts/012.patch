+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace pps_pallet_pose_cpp {
+
+// This synchronized capture. stage2_source_index is the Detection2DArray slot
+// select_detection sent through stage 2. The other class-matched slots stay
+// in candidate order and are not posed.
+struct PairIndexRoster {
+  int stage2_source_index = 0;
+  std::vector<int> deferred_source_indices;
+};
+
+template <typename Candidate>
+inline PairIndexRoster build_pair_index_roster(const std::vector<Candidate>& candidates,
+                                               int sent_slot) {
+  PairIndexRoster roster;
+  roster.stage2_source_index = sent_slot;
+  for (const Candidate& candidate : candidates) {
+    if (candidate.source_index == sent_slot) {
+      continue;
+    }
+    roster.deferred_source_indices.push_back(candidate.source_index);
+  }
+  return roster;
+}
+
+// One diagnostic value. Empty when this pair had one class-matched candidate.
+inline std::string deferred_slots_as_decimal(const std::vector<int>& deferred_source_indices) {
+  std::string text;
+  for (std::size_t index = 0; index < deferred_source_indices.size(); ++index) {
+    if (index > 0) {
+      text.push_back(',');
+    }
+    text += std::to_string(deferred_source_indices[index]);
+  }
+  return text;
+}
+
+}  // namespace pps_pallet_pose_cpp
