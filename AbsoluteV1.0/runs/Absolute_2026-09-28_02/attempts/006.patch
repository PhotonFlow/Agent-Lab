diff --git a/geometry_core/test/test_fused_chamfer_sample.py b/geometry_core/test/test_fused_chamfer_sample.py
new file mode 100644
index 0000000..0bd7047
--- /dev/null
+++ b/geometry_core/test/test_fused_chamfer_sample.py
@@ -0,0 +1,99 @@
+"""Hot-path chamfer samples rotated contour points plus this translation directly.
+
+estimate_pose_chamfer_v3_2 still poses only the pallet select_detection chose.
+Each of the tens of thousands of translations used to copy that rotated contour
+into tls.translated before bilinear sampling. The cost of one translation is the
+same ascending trimmed mean, read from the rotated columns plus tx and ty.
+"""
+
+from __future__ import annotations
+
+import math
+import unittest
+from pathlib import Path
+
+CHAMFER_CPP = Path(__file__).resolve().parents[1] / "src" / "chamfer.cpp"
+
+
+def function_body(text: str, name: str) -> str:
+    start = text.find(name)
+    if start < 0:
+        raise AssertionError(f"{name} is missing")
+    brace = text.find("{", start)
+    if brace < 0:
+        raise AssertionError(f"{name} has no body")
+    depth = 0
+    for index in range(brace, len(text)):
+        char = text[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[brace + 1 : index]
+    raise AssertionError(f"{name} body does not close")
+
+
+def bilinear_sample(x: float, y: float, image, min_x: float, min_y: float, resolution_m: float, penalty: float) -> float:
+    """Same arithmetic as sample_bilinear_into, with translation already in x, y."""
+    height = len(image)
+    width = len(image[0])
+    col_f = (x - min_x) / resolution_m
+    row_f = (y - min_y) / resolution_m
+    c0 = math.floor(col_f)
+    r0 = math.floor(row_f)
+    dx = col_f - float(c0)
+    dy = row_f - float(r0)
+    if r0 >= 0 and r0 + 1 < height and c0 >= 0 and c0 + 1 < width:
+        d00 = float(image[r0][c0])
+        d01 = float(image[r0][c0 + 1])
+        d10 = float(image[r0 + 1][c0])
+        d11 = float(image[r0 + 1][c0 + 1])
+        return (1.0 - dx) * (1.0 - dy) * d00 + dx * (1.0 - dy) * d01 + (1.0 - dx) * dy * d10 + dx * dy * d11
+    return penalty
+
+
+def trimmed_mean(distances: list[float], trim_fraction: float) -> float:
+    ordered = sorted(distances)
+    keep = len(ordered)
+    if trim_fraction > 0.0:
+        keep = max(1, math.ceil((1.0 - trim_fraction) * float(len(ordered))))
+    return sum(ordered[:keep]) / float(keep)
+
+
+class FusedChamferSampleTest(unittest.TestCase):
+    def test_translation_is_added_while_sampling_rotated_columns(self) -> None:
+        body = function_body(CHAMFER_CPP.read_text(encoding="utf-8"), "chamfer_cost_from_rotated")
+        self.assertNotIn("tls.translated", body)
+        self.assertNotIn("sample_bilinear_into", body)
+        self.assertIn("rotated.data()", body)
+        self.assertIn("+ tx", body)
+        self.assertIn("+ ty", body)
+        self.assertIn("trimmed_mean_from_distances", body)
+        self.assertIn("(1.0 - dx) * (1.0 - dy) * d00 + dx * (1.0 - dy) * d01", body)
+        self.assertIn("+ (1.0 - dx) * dy * d10 + dx * dy * d11", body)
+        self.assertIn("std::floor(col_f)", body)
+        self.assertIn("std::floor(row_f)", body)
+
+    def test_trimmed_mean_of_fused_samples_matches_sorted_prefix(self) -> None:
+        # 2 x 2 distance image. Point (0, 0) rotated, then translated by (0.02, -0.01).
+        image = [
+            [0.00, 0.04, 0.08],
+            [0.02, 0.05, 0.09],
+            [0.03, 0.06, 0.10],
+        ]
+        rotated = [(0.00, 0.00), (0.01, 0.00), (0.00, 0.01), (-0.02, 0.03)]
+        tx, ty = 0.02, -0.01
+        min_x, min_y, resolution_m, penalty = -0.05, -0.05, 0.01, 0.25
+        distances = [
+            bilinear_sample(x + tx, y + ty, image, min_x, min_y, resolution_m, penalty) for x, y in rotated
+        ]
+        # trim 0.10 of 4 samples keeps ceil(0.9*4) = 4, so the mean uses every sample.
+        self.assertEqual(trimmed_mean(distances, 0.10), sum(sorted(distances)) / 4.0)
+        samples = [0.2, 0.0, 0.05, 0.4, 0.01, 0.5, 0.03, 0.9, 0.02, 0.8]
+        # ceil(0.9*10) = 9: the largest sample is the only one dropped, in ascending order.
+        self.assertEqual(trimmed_mean(samples, 0.10), sum(sorted(samples)[:9]) / 9.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
