<?xml version="1.0"?>
<package format="3">
  <name>pps_rtdetr_detector</name>
  <version>0.1.0</version>
  <description>RT-DETRv2 stage-1 detector ROS2 wrapper (TensorRT/Mock backends) publishing vision_msgs/Detection2DArray.</description>
  <maintainer email="todo@example.com">PPS</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
