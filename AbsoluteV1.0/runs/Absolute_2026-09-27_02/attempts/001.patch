+      min_y = std::min(min_y, y);
+      max_y = std::max(max_y, y);
+      sum_z += z;
+    }
+    outcome.has_dimensions = true;
+    outcome.width_m = max_x - min_x;
+    outcome.height_m = max_y - min_y;
+    outcome.depth_m = sum_z / static_cast<double>(n);
