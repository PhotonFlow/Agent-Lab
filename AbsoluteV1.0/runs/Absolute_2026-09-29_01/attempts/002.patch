+bool search_window_inside(const Eigen::MatrixXd& rotated, double tx_lo, double tx_hi,
+                          double ty_lo, double ty_hi, const GridMeta& meta, int rows, int cols) {
+  if (rotated.rows() <= 0 || !(meta.resolution_m > 0.0)) {
+    return false;
+  }
+  const double min_x = rotated.col(0).minCoeff();
+  const double max_x = rotated.col(0).maxCoeff();
+  const double min_y = rotated.col(1).minCoeff();
+  const double max_y = rotated.col(1).maxCoeff();
+  const double res = meta.resolution_m;
+  const double col_lo = (min_x + tx_lo - meta.min_xy.x()) / res;
+  const double col_hi = (max_x + tx_hi - meta.min_xy.x()) / res;
+  const double row_lo = (min_y + ty_lo - meta.min_xy.y()) / res;
+  const double row_hi = (max_y + ty_hi - meta.min_xy.y()) / res;
+  // One-pixel margin so the bilinear neighbourhood stays on the image.
+  return col_lo >= 1.0 && row_lo >= 1.0 && col_hi <= static_cast<double>(cols) - 2.0 &&
+         row_hi <= static_cast<double>(rows) - 2.0;
+}
