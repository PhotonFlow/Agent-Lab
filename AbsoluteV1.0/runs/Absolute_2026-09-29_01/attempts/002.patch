+// Same arithmetic as chamfer_cost_from_rotated. When a histogram lower bound
+// already exceeds `reject_at`, skips the trimmed-mean sort and returns
+// `reject_at`. `*anchor_out` receives a value <= the exact cost (exact when
+// computed, otherwise the histogram lower bound) for a Lipschitz prune.
+// `*is_exact` is true when the returned cost is the trimmed mean. Otherwise the
+// cell is proven strictly worse than `reject_at` and the returned cost is
+// `reject_at` itself.
+double chamfer_cost_from_rotated_reject(const Eigen::MatrixXd& rotated, double tx, double ty,
+                                        const cv::Mat& dist_img_m, const GridMeta& meta,
+                                        double trim_fraction, const double* outside_penalty_m,
+                                        ChamferTls& tls, double reject_at, double* anchor_out,
+                                        bool* is_exact);
+
+// True when every contour point, under every translation in the axis-aligned
+// window, lands far enough inside the distance image that bilinear samples
+// never hit the outside penalty. The bilinear distance is then Lipschitz in
+// translation, so a neighbour can be pruned from an evaluated anchor.
+bool search_window_inside(const Eigen::MatrixXd& rotated, double tx_lo, double tx_hi,
+                          double ty_lo, double ty_hi, const GridMeta& meta, int rows, int cols);
+
+// Bilinear samples of a grid-Lipschitz distance change at up to sqrt(2) per
+// metre of translation; 1.5 leaves a margin over that constant.
+inline constexpr double kChamferLipschitz = 1.5;
+
+inline bool lipschitz_worse(double anchor, double ax, double ay, double tx, double ty,
+                            double best_cost) {
+  const double dist = std::hypot(tx - ax, ty - ay);
+  return anchor - kChamferLipschitz * dist > best_cost;
+}
+
 }  // namespace chamfer_detail
 }  // namespace geometry_core
