+// Bilinear sample of `points + (tx, ty)`. Same parenthesization as
+// sample_bilinear_into on a pre-translated matrix: ((x + tx) - min) / res.
+void sample_bilinear_offset_into(const Eigen::Ref<const Eigen::MatrixXd>& points_2d, double tx,
+                                 double ty, const cv::Mat& dist_img_m, const GridMeta& meta,
+                                 double outside_penalty_m, Eigen::ArrayXd& out) {
+  const int H = dist_img_m.rows;
+  const int W = dist_img_m.cols;
+  const size_t step = static_cast<size_t>(dist_img_m.step1());
+  const float* base = dist_img_m.ptr<float>(0);
+  const double min_x = meta.min_xy.x();
+  const double min_y = meta.min_xy.y();
+  const double resolution_m = meta.resolution_m;
+  const long n = points_2d.rows();
+  const double* xs = points_2d.col(0).data();
+  const double* ys = points_2d.col(1).data();
+  out.setConstant(outside_penalty_m);
+
+  for (long i = 0; i < n; ++i) {
+    const double x = xs[i] + tx;
+    const double y = ys[i] + ty;
+    const double col_f = (x - min_x) / resolution_m;
+    const double row_f = (y - min_y) / resolution_m;
+    const long c0 = static_cast<long>(std::floor(col_f));
+    const long r0 = static_cast<long>(std::floor(row_f));
+    const double dx = col_f - static_cast<double>(c0);
+    const double dy = row_f - static_cast<double>(r0);
+
+    if (r0 >= 0 && r0 + 1 < H && c0 >= 0 && c0 + 1 < W) {
+      const float* row0 = base + static_cast<size_t>(r0) * step;
+      const float* row1 = base + static_cast<size_t>(r0 + 1) * step;
+      const double d00 = static_cast<double>(row0[c0]);
+      const double d01 = static_cast<double>(row0[c0 + 1]);
+      const double d10 = static_cast<double>(row1[c0]);
+      const double d11 = static_cast<double>(row1[c0 + 1]);
+      out(i) = (1.0 - dx) * (1.0 - dy) * d00 + dx * (1.0 - dy) * d01 +
+               (1.0 - dx) * dy * d10 + dx * dy * d11;
+    }
+  }
+}
+
+// Lower bound on the trimmed mean. Bin edges are <= the values placed in
+// that bin, so the sum of the lowest edges is <= the sum of the smallest
+// `keep` distances. One ulp is then shaved off so a tight bound cannot hide
+// an equal-cost tie.
+double histogram_lower_mean(const Eigen::ArrayXd& distances, double trim_fraction) {
+  constexpr int kBins = 512;
+  constexpr double kHistMax = 4.0;  // metres; 4/512 is an exact binary width
+  const long n = distances.size();
+  if (n <= 0) {
+    return 0.0;
+  }
+  long keep = n;
+  if (trim_fraction > 0.0) {
+    keep = std::max<long>(
+        1, static_cast<long>(std::ceil((1.0 - trim_fraction) * static_cast<double>(n))));
+  }
+  const double width = kHistMax / static_cast<double>(kBins);
+  const double inv = 1.0 / width;
+  int counts[kBins] = {};
+  const double* data = distances.data();
+  for (long i = 0; i < n; ++i) {
+    const double d = data[i];
+    int b = 0;
+    if (d > 0.0) {
+      b = static_cast<int>(d * inv);
+      if (b >= kBins) {
+        b = kBins - 1;
+      } else if (b < 0) {
+        b = 0;
+      }
+      while (b > 0 && static_cast<double>(b) * width > d) {
+        --b;
+      }
+    }
+    counts[b] += 1;
+  }
+  double lower = 0.0;
+  long remaining = keep;
+  for (int b = 0; b < kBins && remaining > 0; ++b) {
+    const long take = std::min<long>(counts[b], remaining);
+    lower += static_cast<double>(take) * (static_cast<double>(b) * width);
+    remaining -= take;
+  }
+  lower = std::nextafter(lower, 0.0);
+  if (!(lower > 0.0)) {
+    lower = 0.0;
+  }
+  return lower / static_cast<double>(keep);
+}
