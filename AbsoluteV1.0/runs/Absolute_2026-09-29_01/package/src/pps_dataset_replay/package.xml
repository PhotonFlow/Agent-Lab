<?xml version="1.0"?>
<package format="3">
  <name>pps_dataset_replay</name>
  <version>0.1.0</version>
  <description>ROS2 dataset-replay debug tool: replays eval_dataset_combined through the live rtdetr_detector_node + pallet_pose_cpp_node graph via a pre-built rosbag2, joins results back to ground truth, and renders per-sample bbox/pose/GT overlays.</description>
  <maintainer email="todo@example.com">PPS</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pps_rtdetr_detector</exec_depend>
  <exec_depend>pps_pallet_pose_cpp</exec_depend>
  <exec_depend>pps_perception_msgs</exec_depend>
  <exec_depend>pps_perception_bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
