0,"diffString":"--- a/C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\test\\test_frontal_lm_pose.cpp\n+++ b/C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\test\\test_frontal_lm_pose.cpp\n@@ -142,3 +142,31 @@\n   EXPECT_NEAR(outcome.pose.tz, kTz, 1e-3);\n   EXPECT_NEAR(outcome.pose.yaw_rad, 0.0, 1e-3);\n }\n+\n+TEST(FrontalLmPose, SearchBeatsProductionGrid) {\n+  auto proto = build_default_pallet_prototype(1.20, 0.14, 0.47, 0.10, 0.28, 0.03);\n+  Eigen::MatrixXd observed = proto.contour_points;\n+  auto [mask, meta] = rasterize_points_to_mask(observed, 0.005, 0.80);\n+  cv::Mat filled = close_mask(mask, 2, true);\n+  cv::Mat boundary = extract_boundary_mask(filled);\n+  cv::Mat dist = compute_distance_transform_v2(boundary, meta.resolution_m);\n+  PrototypePose2D init{0.0, 0.0, 0.0};\n+  auto time_ms = [](auto&& fn) {\n+    const auto t0 = std::chrono::steady_clock::now();\n+    fn();\n+    const auto t1 = std::chrono::steady_clock::now();\n+    return std::chrono::duration<double, std::milli>(t1 - t0).count();\n+  };\n+  const double grid_ms = time_ms([&] {\n+    two_stage_chamfer_search_v2(proto.contour_points, init, dist, meta, 0.15, 0.15,\n+                                 10.0 * M_PI / 180.0, 0.01, 0.01, 1.0 * M_PI / 180.0, 0.012, 0.012,\n+                                 1.2 * M_PI / 180.0, 0.001, 0.001, 0.2 * M_PI / 180.0, 0.10,\n+                                 nullptr);\n+  });\n+  const double lm_ms = time_ms([&] {\n+    lm_chamfer_search(proto.contour_points, init, dist, meta, 0.162, 0.162,\n+                      11.2 * M_PI / 180.0, 0.10, nullptr);\n+  });\n+  std::cout << \"grid_ms=\" << grid_ms << \" lm_ms=\" << lm_ms << \"\\n\";\n+  EXPECT_LT(lm_ms, grid_ms);\n+}","beforeFullFileContent":"#include <algorithm>\n#include <cmath>\n#include <random>\n#include <vector>\n\n#include <gtest/gtest.h>\n\n#include \"geometry_core/chamfer.hpp\"\n#include \"geometry_core/chamfer_lm.hpp\"\n#include \"geometry_core/pipeline_v3_2.hpp\"\n#include \"geometry_core/prototype.hpp\"\n\nusing geometry_core::close_mask;\nusing geometry_core::compute_distance_transform_v2;\nusing geometry_core::EstimatePoseParams;\nusing geometry_core::estimate_pose_chamfer_v3_2;\nusing geometry_core::extract_boundary_mask;\nusing geometry_core::lm_chamfer_search;\nusing geometry_core::PinholeIntrinsics;\nusing geometry_core::PrototypePose2D;\nusing geometry_core::rasterize_points_to_mask;\nusing geometry_core::RgbDepthCameraConfig;\nusing geometry_core::Stage2Config;\nusing geometry_core::build_default_pallet_prototype;\nusing geometry_core::transform_points_2d;\nusing geometry_core::two_stage_chamfer_search_v2;\n\nnamespace {\n\nEigen::MatrixXd dense_rectangle_contour(double half_w, double half_h, double spacing_m) {\n  Eigen::Matrix<double, 4, 2> corners;\n  corners << -half_w, -half_h, half_w, -half_h, half_w, half_h, -half_w, half_h;\n  std::vector<Eigen::Vector2d> pts;\n  for (int i = 0; i < 4; ++i) {\n    const Eigen::Vector2d p0 = corners.row(i).transpose();\n    const Eigen::Vector2d p1 = corners.row((i + 1) % 4).transpose();\n    const double length = (p1 - p0).norm();\n    const int n = std::max(2, static_cast<int>(std::ceil(length / spacing_m)));\n    for (int k = 0; k < n; ++k) {\n      const double t = static_cast<double>(k) / static_cast<double>(n);\n      pts.push_back(p0 + t * (p1 - p0));\n    }\n  }\n  Eigen::MatrixXd out(static_cast<long>(pts.size()), 2);\n  for (long i = 0; i < out.rows(); ++i) {\n    out.row(i) = pts[static_cast<size_t>(i)].transpose();\n  }\n  return out;\n}\n\nRgbDepthCameraConfig identity_pallet_camera() {\n  RgbDepthCameraConfig cfg;\n  cfg.rgb = PinholeIntrinsics{1064.604003906, 1064.155151367, 967.674560547, 534.171875000, 1920,\n                              1080};\n  cfg.depth = PinholeIntrinsics{393.154327393, 411.884765625, 317.828948975, 244.208724976, 640,\n                                480};\n  cfg.R_dr = Eigen::Matrix3d::Identity();\n  cfg.t_dr = Eigen::Vector3d::Zero();\n  cfg.depth_scale = 0.001;\n  return cfg;\n}\n\ncv::Mat render_frontal_pallet(const RgbDepthCameraConfig& cam, double tz) {\n  cv::Mat depth(cam.depth.height, cam.depth.width, CV_32FC1, cv::Scalar(0));\n  constexpr double kHalfW = 0.60;\n  constexpr double kHalfH = 0.40;\n  constexpr double kPocketHalfW = 0.15;\n  constexpr double kPocketHalfH = 0.05;\n  constexpr double kPocketOffset = 0.30;\n  for (int v = 0; v < cam.depth.height; ++v) {\n    for (int u = 0; u < cam.depth.width; ++u) {\n      const double x = (static_cast<double>(u) - cam.depth.cx) / cam.depth.fx * tz;\n      const double y = (static_cast<double>(v) - cam.depth.cy) / cam.depth.fy * tz;\n      const bool on_face = std::abs(x) <= kHalfW && std::abs(y) <= kHalfH;\n      const bool in_pocket = std::abs(y) <= kPocketHalfH &&\n                             (std::abs(x - kPocketOffset) <= kPocketHalfW ||\n                              std::abs(x + kPocketOffset) <= kPocketHalfW);\n      if (on_face && !in_pocket) {\n        depth.at<float>(v, u) = static_cast<float>(tz);\n      }\n    }\n  }\n  return depth;\n}\n\nEigen::Vector4d face_bbox(const RgbDepthCameraConfig& cam, double tz) {\n  constexpr double kHalfW = 0.60;\n  constexpr double kHalfH = 0.40;\n  const double corners[4][2] = {{-kHalfW, -kHalfH}, {kHalfW, -kHalfH}, {kHalfW, kHalfH},\n                                {-kHalfW, kHalfH}};\n  double u_min = 1e9, v_min = 1e9, u_max = -1e9, v_max = -1e9;\n  for (const auto& corner : corners) {\n    const double u = cam.rgb.fx * corner[0] / tz + cam.rgb.cx;\n    const double v = cam.rgb.fy * corner[1] / tz + cam.rgb.cy;\n    u_min = std::min(u_min, u);\n    v_min = std::min(v_min, v);\n    u_max = std::max(u_max, u);\n    v_max = std::max(v_max, v);\n  }\n  return Eigen::Vector4d(u_min, v_min, u_max, v_max);\n}\n\n}  // namespace\n\nTEST(FrontalLmPose, RecoversOffsetOutsideQuantizationBall) {\n  Eigen::MatrixXd proto = dense_rectangle_contour(0.1, 0.05, 0.005);\n  const double true_theta = 0.05;\n  const double true_tx = 0.02;\n  const double true_ty = -0.01;\n  PrototypePose2D true_pose{true_theta, true_tx, true_ty};\n  Eigen::MatrixXd observed = transform_points_2d(proto, true_pose);\n\n  auto [mask, meta] = rasterize_points_to_mask(observed, 0.005, 0.08);\n  cv::Mat filled = close_mask(mask, 2, true);\n  cv::Mat boundary = extract_boundary_mask(filled);\n  cv::Mat dist = compute_distance_transform_v2(boundary, meta.resolution_m);\n\n  PrototypePose2D init_pose{0.0, 0.0, 0.0};\n  auto [best_pose, best_cost] = lm_chamfer_search(\n      proto, init_pose, dist, meta, /*max_dx_m=*/0.05, /*max_dy_m=*/0.05,\n      /*max_dtheta_rad=*/0.15, /*trim_fraction=*/0.0, nullptr);\n\n  EXPECT_NEAR(best_pose.tx, true_tx, 0.004);\n  EXPECT_NEAR(best_pose.ty, true_ty, 0.004);\n  EXPECT_NEAR(best_pose.theta_rad, true_theta, 0.011);\n  EXPECT_LT(best_cost, 0.003);\n}\n\nTEST(FrontalLmPose, KeepsRayPlaneCentre) {\n  RgbDepthCameraConfig camera = identity_pallet_camera();\n  constexpr double kTz = 2.0;\n  cv::Mat depth = render_frontal_pallet(camera, kTz);\n  Eigen::Vector4d bbox = face_bbox(camera, kTz);\n\n  Stage2Config cfg;\n  EstimatePoseParams params;\n  std::mt19937_64 rng(0);\n  auto outcome = estimate_pose_chamfer_v3_2(bbox, depth, camera, cfg, params, std::nullopt, rng);\n  ASSERT_TRUE(outcome.ok) << outcome.failure.failure_reason;\n  EXPECT_NEAR(outcome.pose.tx, 0.0, 5e-4);\n  EXPECT_NEAR(outcome.pose.ty, 0.0, 5e-4);\n  EXPECT_NEAR(outcome.pose.tz, kTz, 1e-3);\n  EXPECT_NEAR(outcome.pose.yaw_rad, 0.0, 1e-3);\n}\n","afterFullFileContent":"#include <algorithm>\n#include <cmath>\n#include <random>\n#include <vector>\n\n#include <gtest/gtest.h>\n\n#include \"geometry_core/chamfer.hpp\"\n#include \"geometry_core/chamfer_lm.hpp\"\n#include \"geometry_core/pipeline_v3_2.hpp\"\n#include \"geometry_core/prototype.hpp\"\n\nusing geometry_core::close_mask;\nusing geometry_core::compute_distance_transform_v2;\nusing geometry_core::EstimatePoseParams;\nusing geometry_core::estimate_pose_chamfer_v3_2;\nusing geometry_core::extract_boundary_mask;\nusing geometry_core::lm_chamfer_search;\nusing geometry_core::PinholeIntrinsics;\nusing geometry_core::PrototypePose2D;\nusing geometry_core::rasterize_points_to_mask;\nusing geometry_core::RgbDepthCameraConfig;\nusing geometry_core::Stage2Config;\nusing geometry_core::build_default_pallet_prototype;\nusing geometry_core::transform_points_2d;\nusing geometry_core::two_stage_chamfer_search_v2;\n\nnamespace {\n\nEigen::MatrixXd dense_rectangle_contour(double half_w, double half_h, double spacing_m) {\n  Eigen::Matrix<double, 4, 2> corners;\n  corners << -half_w, -half_h, half_w, -half_h, half_w, half_h, -half_w, half_h;\n  std::vector<Eigen::Vector2d> pts;\n  for (int i = 0; i < 4; ++i) {\n    const Eigen::Vector2d p0 = corners.row(i).transpose();\n    const Eigen::Vector2d p1 = corners.row((i + 1) % 4).transpose();\n    const double length = (p1 - p0).norm();\n    const int n = std::max(2, static_cast<int>(std::ceil(length / spacing_m)));\n    for (int k = 0; k < n; ++k) {\n      const double t = static_cast<double>(k) / static_cast<double>(n);\n      pts.push_back(p0 + t * (p1 - p0));\n    }\n  }\n  Eigen::MatrixXd out(static_cast<long>(pts.size()), 2);\n  for (long i = 0; i < out.rows(); ++i) {\n    out.row(i) = pts[static_cast<size_t>(i)].transpose();\n  }\n  return out;\n}\n\nRgbDepthCameraConfig identity_pallet_camera() {\n  RgbDepthCameraConfig cfg;\n  cfg.rgb = PinholeIntrinsics{1064.604003906, 1064.155151367, 967.674560547, 534.171875000, 1920,\n                              1080};\n  cfg.depth = PinholeIntrinsics{393.154327393, 411.884765625, 317.828948975, 244.208724976, 640,\n                                480};\n  cfg.R_dr = Eigen::Matrix3d::Identity();\n  cfg.t_dr = Eigen::Vector3d::Zero();\n  cfg.depth_scale = 0.001;\n  return cfg;\n}\n\ncv::Mat render_frontal_pallet(const RgbDepthCameraConfig& cam, double tz) {\n  cv::Mat depth(cam.depth.height, cam.depth.width, CV_32FC1, cv::Scalar(0));\n  constexpr double kHalfW = 0.60;\n  constexpr double kHalfH = 0.40;\n  constexpr double kPocketHalfW = 0.15;\n  constexpr double kPocketHalfH = 0.05;\n  constexpr double kPocketOffset = 0.30;\n  for (int v = 0; v < cam.depth.height; ++v) {\n    for (int u = 0; u < cam.depth.width; ++u) {\n      const double x = (static_cast<double>(u) - cam.depth.cx) / cam.depth.fx * tz;\n      const double y = (static_cast<double>(v) - cam.depth.cy) / cam.depth.fy * tz;\n      const bool on_face = std::abs(x) <= kHalfW && std::abs(y) <= kHalfH;\n      const bool in_pocket = std::abs(y) <= kPocketHalfH &&\n                             (std::abs(x - kPocketOffset) <= kPocketHalfW ||\n                              std::abs(x + kPocketOffset) <= kPocketHalfW);\n      if (on_face && !in_pocket) {\n        depth.at<float>(v, u) = static_cast<float>(tz);\n      }\n    }\n  }\n  return depth;\n}\n\nEigen::Vector4d face_bbox(const RgbDepthCameraConfig& cam, double tz) {\n  constexpr double kHalfW = 0.60;\n  constexpr double kHalfH = 0.40;\n  const double corners[4][2] = {{-kHalfW, -kHalfH}, {kHalfW, -kHalfH}, {kHalfW, kHalfH},\n                                {-kHalfW, kHalfH}};\n  double u_min = 1e9, v_min = 1e9, u_max = -1e9, v_max = -1e9;\n  for (const auto& corner : corners) {\n    const double u = cam.rgb.fx * corner[0] / tz + cam.rgb.cx;\n    const double v = cam.rgb.fy * corner[1] / tz + cam.rgb.cy;\n    u_min = std::min(u_min, u);\n    v_min = std::min(v_min, v);\n    u_max = std::max(u_max, u);\n    v_max = std::max(v_max, v);\n  }\n  return Eigen::Vector4d(u_min, v_min, u_max, v_max);\n}\n\n}  // namespace\n\nTEST(FrontalLmPose, RecoversOffsetOutsideQuantizationBall) {\n  Eigen::MatrixXd proto = dense_rectangle_contour(0.1, 0.05, 0.005);\n  const double true_theta = 0.05;\n  const double true_tx = 0.02;\n  const double true_ty = -0.01;\n  PrototypePose2D true_pose{true_theta, true_tx, true_ty};\n  Eigen::MatrixXd observed = transform_points_2d(proto, true_pose);\n\n  auto [mask, meta] = rasterize_points_to_mask(observed, 0.005, 0.08);\n  cv::Mat filled = close_mask(mask, 2, true);\n  cv::Mat boundary = extract_boundary_mask(filled);\n  cv::Mat dist = compute_distance_transform_v2(boundary, meta.resolution_m);\n\n  PrototypePose2D init_pose{0.0, 0.0, 0.0};\n  auto [best_pose, best_cost] = lm_chamfer_search(\n      proto, init_pose, dist, meta, /*max_dx_m=*/0.05, /*max_dy_m=*/0.05,\n      /*max_dtheta_rad=*/0.15, /*trim_fraction=*/0.0, nullptr);\n\n  EXPECT_NEAR(best_pose.tx, true_tx, 0.004);\n  EXPECT_NEAR(best_pose.ty, true_ty, 0.004);\n  EXPECT_NEAR(best_pose.theta_rad, true_theta, 0.011);\n  EXPECT_LT(best_cost, 0.003);\n}\n\nTEST(FrontalLmPose, KeepsRayPlaneCentre) {\n  RgbDepthCameraConfig camera = identity_pallet_camera();\n  constexpr double kTz = 2.0;\n  cv::Mat depth = render_frontal_pallet(camera, kTz);\n  Eigen::Vector4d bbox = face_bbox(camera, kTz);\n\n  Stage2Config cfg;\n  EstimatePoseParams params;\n  std::mt19937_64 rng(0);\n  auto outcome = estimate_pose_chamfer_v3_2(bbox, depth, camera, cfg, params, std::nullopt, rng);\n  ASSERT_TRUE(outcome.ok) << outcome.failure.failure_reason;\n  EXPECT_NEAR(outcome.pose.tx, 0.0, 5e-4);\n  EXPECT_NEAR(outcome.pose.ty, 0.0, 5e-4);\n  EXPECT_NEAR(outcome.pose.tz, kTz, 1e-3);\n  EXPECT_NEAR(outcome.pose.yaw_rad, 0.0, 1e-3);\n}\n\nTEST(FrontalLmPose, SearchBeatsProductionGrid) {\n  auto proto = build_default_pallet_prototype(1.20, 0.14, 0.47, 0.10, 0.28, 0.03);\n  Eigen::MatrixXd observed = proto.contour_points;\n  auto [mask, meta] = rasterize_points_to_mask(observed, 0.005, 0.80);\n  cv::Mat filled = close_mask(mask, 2, true);\n  cv::Mat boundary = extract_boundary_mask(filled);\n  cv::Mat dist = compute_distance_transform_v2(boundary, meta.resolution_m);\n  PrototypePose2D init{0.0, 0.0, 0.0};\n  auto time_ms = [](auto&& fn) {\n    const auto t0 = std::chrono::steady_c