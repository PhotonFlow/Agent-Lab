t Eigen::Vector2d* anchor_xy, double prior_lambda,\n                              Eigen::Matrix3d* hessian, Eigen::Vector3d* gradient) {\n  const long n = rotated.rows();\n  std::vector<PointResidual> samples(static_cast<size_t>(n));\n  std::vector<std::pair<double, long>> order;\n  order.reserve(static_cast<size_t>(n));\n  for (long i = 0; i < n; ++i) {\n    samples[static_cast<size_t>(i)] =\n        sample_bilinear_jacobian(rotated, i, tx, ty, dist_img_m, meta, penalty);\n    order.emplace_back(samples[static_cast<size_t>(i)].value, i);\n  }\n  const long keep = trimmed_keep_count(n, trim_fraction);\n  std::partial_sort(order.begin(), order.begin() + keep, order.end(),\n                    [](const std::pair<double, long>& a, const std::pair<double, long>& b) {\n                      return a.first < b.first;\n                    });\n\n  double energy = 0.0;\n  if (hessian != nullptr) {\n    hessian->setZero();\n    gradient->setZero();\n  }\n  for (long k = 0; k < keep; ++k) {\n    const PointResidual& sample = samples[static_cast<size_t>(order[static_cast<size_t>(k)].second)];\n    energy += sample.value * sample.value;\n    if (hessian != nullptr) {\n      Eigen::Vector3d jacobian(sample.d_dtheta, sample.d_dtx, sample.d_dty);\n      *hessian += jacobian * jacobian.transpose();\n      *gradient += jacobian * sample.value;\n    }\n  }\n  if (anchor_xy != nullptr && prior_lambda > 0.0) {\n    const double dx = tx - anchor_xy->x();\n    const double dy = ty - anchor_xy->y();\n    const double weight = prior_lambda * static_cast<double>(keep);\n    energy += weight * (dx * dx + dy * dy);\n    if (hessian != nullptr) {\n      const double scale = std::sqrt(weight);\n      Eigen::Vector3d jx(0.0, scale, 0.0);\n      Eigen::Vector3d jy(0.0, 0.0, scale);\n      *hessian += jx * jx.transpose();\n      *hessian += jy * jy.transpose();\n      *gradient += jx * (scale * dx);\n      *gradient += jy * (scale * dy);\n    }\n  }\n  return energy;\n}\n\n}  // namespace\n\nstd::pair<PrototypePose2D, double> lm_chamfer_search(\n    const Eigen::Ref<const Eigen::MatrixXd>& proto_points_2d, const PrototypePose2D& init_pose,\n    const cv::Mat& dist_img_m, const GridMeta& meta, double max_dx_m, double max_dy_m,\n    double max_dtheta_rad, double trim_fraction, const double* outside_penalty_m,\n    const Eigen::Vector2d* anchor_xy, double prior_lambda) {\n  const double penalty =\n      outside_penalty_m != nullptr ? *outside_penalty_m : 50.0 * meta.resolution_m;\n  PrototypePose2D pose = init_pose;\n  if (proto_points_2d.rows() == 0 || dist_img_m.empty() || meta.resolution_m <= 0.0) {\n    return {pose, chamfer_cost_v2(proto_points_2d, pose, dist_img_m, meta, trim_fraction,\n                                   outside_penalty_m)};\n  }\n\n  Eigen::MatrixXd rotated(proto_points_2d.rows(), 2);\n  rotate_proto(proto_points_2d, pose.theta_rad, rotated);\n  double lambda = 1e-2;\n  constexpr int kMaxIterations = 25;\n  constexpr double kMaxStepTheta = 0.02;\n  constexpr double kMaxStepTranslation = 0.01;\n\n  for (int iter = 0; iter < kMaxIterations; ++iter) {\n    Eigen::Matrix3d hessian;\n    Eigen::Vector3d gradient;\n    const double current = squared_trimmed_energy(rotated, pose.tx, pose.ty, dist_img_m, meta,\n                                                   trim_fraction, penalty, anchor_xy, prior_lambda,\n                                                   &hessian, &gradient);\n    Eigen::Matrix3d damped = hessian;\n    for (int axis = 0; axis < 3; ++axis) {\n      damped(axis, axis) += lambda * std::max(hessian(axis, axis), 1e-8);\n    }\n    const Eigen::Vector3d delta = damped.ldlt().solve(-gradient);\n    if (!delta.allFinite()) {\n      lambda = std::min(1e8, lambda * 10.0);\n      continue;\n    }\n    Eigen::Vector3d step = delta;\n    step[0] = std::clamp(step[0], -kMaxStepTheta, kMaxStepTheta);\n    step[1] = std::clamp(step[1], -kMaxStepTranslation, kMaxStepTranslation);\n    step[2] = std::clamp(step[2], -kMaxStepTranslation, kMaxStepTranslation);\n\n    bool accepted = false;\n    double alpha = 1.0;\n    for (int line = 0; line < 8; ++line) {\n      PrototypePose2D trial = pose;\n      trial.theta_rad += alpha * step[0];\n      trial.tx += alpha * step[1];\n      trial.ty += alpha * step[2];\n      if (!inside_window(init_pose, trial, max_dx_m, max_dy_m, max_dtheta_rad)) {\n        alpha *= 0.5;\n        continue;\n      }\n      Eigen::MatrixXd trial_rotated(proto_points_2d.rows(), 2);\n      rotate_proto(proto_points_2d, trial.theta_rad, trial_rotated);\n      const double trial_energy = squared_trimmed_energy(\n          trial_rotated, trial.tx, trial.ty, dist_img_m, meta, trim_fraction, penalty, anchor_xy,\n          prior_lambda, nullptr, nullptr);\n      if (trial_energy < current - 1e-12) {\n        pose = trial;\n        rotated = std::move(trial_rotated);\n        lambda = std::max(1e-6, lambda * 0.3);\n        accepted = true;\n        if (std::abs(alpha * step[0]) < 1e-3 && std::abs(alpha * step[1]) < 2e-4 &&\n            std::abs(alpha * step[2]) < 2e-4) {\n          iter = kMaxIterations;\n        }\n        break;\n      }\n      alpha *= 0.5;\n    }\n    if (!accepted) {\n      lambda *= 10.0;\n      if (lambda > 1e8) {\n        break;\n      }\n    }\n  }\n\n  return {pose, chamfer_cost_v2(proto_points_2d, pose, dist_img_m, meta, trim_fraction,\n                                 outside_penalty_m)};\n}\n\n}  // namespace geometry_core\n"},"result":{"success":{"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\src\\chamfer_lm.cpp","linesAdded":222,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b/C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\src\\chamfer_lm.cpp\n@@ -1,0 +1,222 @@\n+#include \"geometry_core/chamfer_lm.hpp\"\n+\n+#include <algorithm>\n+#include <cmath>\n+#include <vector>\n+\n+#include \"geometry_core/ch