] = lm_chamfer_search(\n        proto.contour_points, init_pose, dist_img_m, grid_meta,\n        params.prior_coarse_dx_m + params.fine_dx_m,\n        params.prior_coarse_dy_m + params.fine_dy_m,\n        params.coarse_dtheta_rad + params.fine_dtheta_rad, params.trim_fraction,\n        outside_penalty_ptr, &anchor_xy, lambda_eff);","isEmpty":false,"exceededLimit":false,"totalLines":259,"fileSize":11611,"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\src\\pipeline_v3_2.cpp","readRange":{"startLine":140,"endLine":179},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-3873a1c4-cea5-4e63-a983-b085cbb0c5b3-107\nfc_3e9e302a-defb-9d44-96ca-b52017a96f14_0","startedAtMs":"1790672551502","completedAtMs":"1790672551803"},"model_call_id":"c7808179-6b9d-4883-ae7c-59f15050decd-18-ood6","session_id":"c7c25dbd-465c-4bfd-8cfe-9e43fb7443c6","timestamp_ms":1790672550934}
