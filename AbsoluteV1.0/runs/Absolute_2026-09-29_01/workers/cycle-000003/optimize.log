ed_energy(rotated, pose.tx, pose.ty, dist_img_m, meta,\n                                                   trim_fraction, penalty, anchor_xy, prior_lambda,\n                                                   &hessian, &gradient);\n    Eigen::Matrix3d damped = hessian;\n    for (int axis = 0; axis < 3; ++axis) {\n      damped(axis, axis) += lambda * std::max(hessian(axis, axis), 1e-8);\n    }\n    const Eigen::Vector3d delta = damped.ldlt().solve(-gradient);\n    if (!delta.allFinite()) {\n      lambda = std::min(1e8, lambda * 10.0);\n      continue;\n    }\n    Eigen::Vector3d step = delta;\n    step[0] = std::clamp(step[0], -kMaxStepTheta, kMaxStepTheta);\n    step[1] = std::clamp(step[1], -kMaxStepTranslation, kMaxStepTranslation);\n    step[2] = std::clamp(step[2], -kMaxStepTranslation, kMaxStepTranslation);\n\n    bool accepted = false;\n    double alpha = 1.0;\n    for (int line = 0; line < 8; ++line) {\n      PrototypePose2D trial = pose;\n      trial.theta_rad += alpha * step[0];\n      trial.tx += alpha * step[1];\n      trial.ty += alpha * step[2];\n      if (!inside_window(init_pose, trial, max_dx_m, max_dy_m, max_dtheta_rad)) {\n        alpha *= 0.5;\n        continue;\n      }\n      Eigen::MatrixXd trial_rotated(proto_points_2d.rows(), 2);\n      rotate_proto(proto_points_2d, trial.theta_rad, trial_rotated);\n      const double trial_energy = squared_trimmed_energy(\n          trial_rotated, trial.tx, trial.ty, dist_img_m, meta, trim_fraction, penalty, anchor_xy,\n          prior_lambda, nullptr, nullptr);\n      if (trial_energy < current - 1e-12) {\n        pose = trial;\n        rotated = std::move(trial_rotated);\n        lambda = std::max(1e-6, lambda * 0.3);\n        accepted = true;\n        if (std::abs(alpha * step[0]) < 1e-3 && std::abs(alpha * step[1]) < 2e-4 &&\n            std::abs(alpha * step[2]) < 2e-4) {\n          iter = kMaxIterations;\n        }\n        break;\n      }\n      alpha *= 0.5;\n    }\n    if (!accepted) {\n      lambda 