8,"linesRemoved":8,"diffString":"--- a/C:\\Users\\alanpeng\\AppData\\Local\\Temp\\pose_bias_probe.py\n+++ b/C:\\Users\\alanpeng\\AppData\\Local\\Temp\\pose_bias_probe.py\n@@ -257,30 +257,40 @@\n \n     print(\"init pose err mm\", pose_err_mm(centre_2d[0], centre_2d[1])[0])\n \n+    aabb_c = 0.5 * (obs.min(0) + obs.max(0))\n+    print(\"aabb pose err mm\", round(pose_err_mm(aabb_c[0], aabb_c[1])[0], 3))\n+\n     for name, proto in configs.items():\n         best = None\n-        # local grid around bbox centre: +/- 15 mm, 1 mm; theta 0 and +/- 0.2 deg\n-        thetas = [0.0, math.radians(0.2), math.radians(-0.2), math.pi]\n+        thetas = [math.pi / 2 + math.radians(d) for d in (0, 0.2, -0.2, 1.0, -1.0)]\n+        thetas += [-math.pi / 2 + math.radians(d) for d in (0, 0.2, -0.2)]\n+        costs_at_centre = []\n         for th in thetas:\n-            for iy in range(-15, 16):\n+            c0 = chamfer(proto, th, centre_2d[0], centre_2d[1], dist, min_xy, res)\n+            costs_at_centre.append((c0, th))\n+            for iy in range(-8, 9):\n                 ty = centre_2d[1] + iy * 0.001\n-                for ix in range(-15, 16):\n+                for ix in range(-8, 9):\n                     tx = centre_2d[0] + ix * 0.001\n                     cost = chamfer(proto, th, tx, ty, dist, min_xy, res)\n                     if best is None or cost < best[0]:\n                         best = (cost, th, tx, ty)\n         err, _ = pose_err_mm(best[2], best[3])\n         shift = math.hypot(best[2] - centre_2d[0], best[3] - centre_2d[1])\n+        centre_best = min(costs_at_centre)\n         print(\n             name,\n+            \"centre_cost\",\n+            round(centre_best[0], 6),\n+            \"centre_theta\",\n+            round(centre_best[1], 5),\n             \"best_cost\",\n             round(best[0], 6),\n             \"theta\",\n             round(best[1], 5),\n-            \"tx\",\n-            round(best[2], 5),\n-            \"ty\",\n-            round(best[3], 5),\n+            \"dxy_mm\",\n+            round(1000 * (best[2] - centre_2d[0]), 3),\n+            round(1000 * (best[3] - centre_2d[1]), 3),\n             \"shift_mm\",\n             round(1000 * shift, 3),\n             \"pose_err_mm\",","beforeFullFileContent":"\"\"\"Probe frontal-pallet centre bias. Mirrors geometry_core pose path.\"\"\"\nfrom __future__ import annotations\n\nimport math\nimport sys\n\nimport cv2\nimport numpy as np\nimport yaml\n\nSRC = r\"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\"\nsys.path.insert(0, SRC + r\"\\pps_perception_bringup\")\nfrom pps_perception_bringup.synthetic_scene import (  # noqa: E402\n    HALF_H,\n    HALF_W,\n    TZ_M,\n    face_bbox_rgb,\n    load_camera,\n    render_depth_mm,\n)\n\nCAM_YAML = SRC + r\"\\pps_perception_bringup\\config\\camera.yaml\"\n\n\ndef sample_segment(p0, p1, spacing):\n    length = float(np.linalg.norm(p1 - p0))\n    n = max(2, int(math.ceil(length / spacing)) + 1)\n    out = []\n    for i in range(n):\n        t = i / n\n        out.append(p0 + t * (p1 - p0))\n    return np.asarray(out)\n\n\ndef sample_rect(w, h, cx, cy, spacing):\n    hw, hh = 0.5 * w, 0.5 * h\n    corners = np.array(\n        [\n            [cx - hw, cy - hh],\n            [cx + hw, cy - hh],\n            [cx + hw, cy + hh],\n            [cx - hw, cy + hh],\n        ]\n    )\n    parts = [sample_segment(corners[i], corners[(i + 1) % 4], spacing) for i in range(4)]\n    return np.vstack(parts)\n\n\ndef prototype(w, h, pw, ph, poff, spacing):\n    outer = sample_rect(w, h, 0, 0, spacing)\n    hole_l = sample_rect(pw, ph, -poff, 0, spacing)\n    hole_r = sample_rect(pw, ph, poff, 0, spacing)\n    return np.vstack([outer, hole_l, hole_r])\n\n\ndef build_mask(bbox, h, w, erode_px=2):\n    x1, y1, x2, y2 = bbox\n    x1i = max(0, int(round(min(x1, x2))))\n    y1i = max(0, int(round(min(y1, y2))))\n    x2i = min(w, int(round(max(x1, x2))))\n    y2i = min(h, int(round(max(y1, y2))))\n    mask = np.zeros((h, w), np.uint8)\n    if x2i > x1i and y2i > y1i:\n        mask[y1i:y2i, x1i:x2i] = 1\n    if erode_px > 0:\n        kernel = np.ones((3, 3), np.uint8)\n        mask = cv2.erode(mask, kernel, iterations=erode_px)\n    return mask\n\n\ndef sample_points(depth_m, mask_rgb, cam):\n    K_d = np.array(\n        [[cam.depth.fx, 0, cam.depth.cx], [0, cam.depth.fy, cam.depth.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    K_d_inv = np.linalg.inv(K_d)\n    K_r = np.array(\n        [[cam.rgb.fx, 0, cam.rgb.cx], [0, cam.rgb.fy, cam.rgb.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    Hd, Wd = depth_m.shape\n    pts = []\n    for v in range(Hd):\n        row = depth_m[v]\n        for u in range(Wd):\n            z = float(row[u])\n            if not np.isfinite(z) or z < 0.3 or z > 5.0:\n                continue\n            ray = K_d_inv @ np.array([u, v, 1.0])\n            p_d = ray * z\n            p_r = cam.R_dr @ p_d + cam.t_dr\n            if p_r[2] <= 0:\n                continue\n            uv = np.array(\n                [\n                    K_r[0, 0] * p_r[0] / p_r[2] + K_r[0, 2],\n                    K_r[1, 1] * p_r[1] / p_r[2] + K_r[1, 2],\n                ]\n            )\n            ui, vi = int(round(uv[0])), int(round(uv[1]))\n            if ui < 0 or ui >= cam.rgb.width or vi < 0 or vi >= cam.rgb.height:\n                continue\n            if mask_rgb[vi, ui] == 0:\n                continue\n            pts.append(p_d)\n    return np.asarray(pts)\n\n\ndef plane_basis(points):\n    centroid = points.mean(axis=0)\n    _, _, vt = np.linalg.svd(points - centroid, full_matrices=False)\n    normal = vt[-1]\n    if normal[2] > 0:\n        normal = -normal\n    offset = -float(normal @ centroid)\n    origin = -offset * normal\n    e_up = np.array([0.0, -1.0, 0.0])\n    if abs(e_up @ normal) > 0.95:\n        e_up = np.array([1.0, 0.0, 0.0])\n    u = e_up - (e_up @ normal) * normal\n    axis_u = u / np.linalg.norm(u)\n    if axis_u[0] < 0:\n        axis_u = -axis_u\n    axis_v = np.cross(normal, axis_u)\n    axis_v = axis_v / np.linalg.norm(axis_v)\n    return normal, offset, origin, axis_u, axis_v\n\n\ndef project_2d(points, origin, axis_u, axis_v):\n    rel = points - origin\n    return np.column_stack([rel @ axis_u, rel @ axis_v])\n\n\ndef rasterize(points, resolution, padding):\n    min_xy = points.min(axis=0) - padding\n    max_xy = points.max(axis=0) + padding\n    width = int(math.ceil((max_xy[0] - min_xy[0]) / resolution)) + 1\n    height = int(math.ceil((max_xy[1] - min_xy[1]) / resolution)) + 1\n    mask = np.zeros((height, width), np.uint8)\n    cols = np.rint((points[:, 0] - min_xy[0]) / resolution).astype(int)\n    rows = np.rint((points[:, 1] - min_xy[1]) / resolution).astype(int)\n    ok = (rows >= 0) & (rows < height) & (cols >= 0) & (cols < width)\n    mask[rows[ok], cols[ok]] = 1\n    return mask, min_xy, resolution\n\n\ndef close_and_edge(mask, close_radius=2):\n    src = mask.copy()\n    if close_radius > 0:\n        k = 2 * close_radius + 1\n        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k, k))\n        src = cv2.morphologyEx(src, cv2.MORPH_CLOSE, kernel)\n    n, labels, stats, _ = cv2.connectedComponentsWithStats(src, 8)\n    if n > 1:\n        areas = stats[1:, cv2.CC_STAT_AREA]\n        largest = 1 + int(np.argmax(areas))\n        src = (labels == largest).astype(np.uint8)\n    kernel = np.ones((3, 3), np.uint8)\n    eroded = cv2.erode(src, kernel, iterations=1)\n    edge = cv2.bitwise_and(src, cv2.bitwise_not(eroded))\n    return edge\n\n\ndef dist_transform(edge, resolution):\n    src = np.where(edge != 0, 0, 1).astype(np.uint8)\n    dist_px = cv2.distanceTransform(src, cv2.DIST_L2, cv2.DIST_MASK_PRECISE)\n    return dist_px.astype(np.float32) * resolution\n\n\ndef sample_bilinear(points, dist, min_xy, resolution, penalty):\n    H, W = dist.shape\n    col_f = (points[:, 0] - min_xy[0]) / resolution\n    row_f = (points[:, 1] - min_xy[1]) / resolution\n    c0 = np.floor(col_f).astype(int)\n    r0 = np.floor(row_f).astype(int)\n    dx = col_f - c0\n    dy = row_f - r0\n    out = np.full(points.shape[0], penalty)\n    ok = (r0 >= 0) & (r0 + 1 < H) & (c0 >= 0) & (c0 + 1 < W)\n    r0o, c0o, dxo, dyo = r0[ok], c0[ok], dx[ok], dy[ok]\n    d00 = dist[r0o, c0o]\n    d01 = dist[r0o, c0o + 1]\n    d10 = dist[r0o + 1, c0o]\n    d11 = dist[r0o + 1, c0o + 1]\n    out[ok] = (1 - dxo) * (1 - dyo) * d00 + dxo * (1 - dyo) * d01 + (1 - dxo) * dyo * d10 + dxo * dyo * d11\n    return out\n\n\ndef trimmed_mean(distances, trim=0.10):\n    s = np.sort(distances)\n    keep = max(1, int(math.ceil((1 - trim) * len(s))))\n    return float(s[:keep].mean())\n\n\ndef chamfer(proto, theta, tx, ty, dist, min_xy, resolution):\n    c, s = math.cos(theta), math.sin(theta)\n    R = np.array([[c, -s], [s, c]])\n    pts = proto @ R.T\n    pts = pts + np.array([tx, ty])\n    penalty = 50.0 * resolution\n    return trimmed_mean(sample_bilinear(pts, dist, min_xy, resolution, penalty))\n\n\ndef ray_plane(uv, cam, normal, offset):\n    K_r = np.array(\n        [[cam.rgb.fx, 0, cam.rgb.cx], [0, cam.rgb.fy, cam.rgb.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    ray_r = np.linalg.inv(K_r) @ np.array([uv[0], uv[1], 1.0])\n    R_rd = cam.R_dr.T\n    t_rd = -R_rd @ cam.t_dr\n    origin_d = t_rd\n    dir_d = R_rd @ ray_r\n    denom = float(normal @ dir_d)\n    t = -(float(normal @ origin_d) + offset) / denom\n    return origin_d + t * dir_d\n\n\ndef main():\n    cam = load_camera(CAM_YAML)\n    depth_mm = render_depth_mm(cam, tz=TZ_M)\n    depth_m = depth_mm.astype(np.float32) * 0.001\n    depth_m[depth_mm == 0] = 0\n    bbox = face_bbox_rgb(cam, tz=TZ_M)\n    mask = build_mask(bbox, cam.rgb.height, cam.rgb.width, 2)\n    print(\"sampling points...\")\n    pts = sample_points(depth_m, mask, cam)\n    print(\"n_points\", len(pts))\n    normal, offset, origin, axis_u, axis_v = plane_basis(pts)\n    obs = project_2d(pts, origin, axis_u, axis_v)\n    print(\"obs aabb center\", obs.min(0), obs.max(0), 0.5 * (obs.min(0) + obs.max(0)))\n    print(\"obs mean\", obs.mean(0))\n\n    resolution = 0.005\n    mask_r, min_xy, res = rasterize(obs, resolution, 0.80)\n    edge = close_and_edge(mask_r, 2)\n    dist = dist_transform(edge, res)\n\n    # default prototype vs scene-matched prototype\n    configs = {\n        \"default_model\": prototype(1.20, 0.14, 0.47, 0.10, 0.28, 0.03),\n        \"scene_model\": prototype(2 * HALF_W, 2 * HALF_H, 0.30, 0.10, 0.30, 0.03),\n    }\n\n    centre_uv = np.array([0.5 * (bbox[0] + bbox[2]), 0.5 * (bbox[1] + bbox[3])])\n    centre_d = ray_plane(centre_uv, cam, normal, offset)\n    centre_2d = project_2d(centre_d.reshape(1, 3), origin, axis_u, axis_v)[0]\n    true_d = np.array([0.0, 0.0, TZ_M])\n    true_r = cam.R_dr @ true_d + cam.t_dr\n    print(\"bbox centre 2d\", centre_2d, \"3d err mm\", 1000 * np.linalg.norm(centre_d - true_d))\n    print(\"true rgb\", true_r)\n\n    def pose_err_mm(tx, ty):\n        p = origin + tx * axis_u + ty * axis_v\n        pr = cam.R_dr @ p + cam.t_dr\n        return 1000 * np.linalg.norm(pr - true_r), p\n\n    print(\"init pose err mm\", pose_err_mm(centre_2d[0], centre_2d[1])[0])\n\n    for name, proto in configs.items():\n        best = None\n        # local grid around bbox centre: +/- 15 mm, 1 mm; theta 0 and +/- 0.2 deg\n        thetas = [0.0, math.radians(0.2), math.radians(-0.2), math.pi]\n        for th in thetas:\n            for iy in range(-15, 16):\n                ty = centre_2d[1] + iy * 0.001\n                for ix in range(-15, 16):\n                    tx = centre_2d[0] + ix * 0.001\n                    cost = chamfer(proto, th, tx, ty, dist, min_xy, res)\n                    if best is None or cost < best[0]:\n                        best = (cost, th, tx, ty)\n        err, _ = pose_err_mm(best[2], best[3])\n        shift = math.hypot(best[2] - centre_2d[0], best[3] - centre_2d[1])\n        print(\n            name,\n            \"best_cost\",\n            round(best[0], 6),\n            \"theta\",\n            round(best[1], 5),\n            \"tx\",\n            round(best[2], 5),\n            \"ty\",\n            round(best[3], 5),\n            \"shift_mm\",\n            round(1000 * shift, 3),\n            \"pose_err_mm\",\n            round(err, 3),\n        )\n\n\nif __name__ == \"__main__\":\n    main()\n","afterFullFileContent":"\"\"\"Probe frontal-pallet centre bias. Mirrors geometry_core pose path.\"\"\"\nfrom __future__ import annotations\n\nimport math\nimport sys\n\nimport cv2\nimport numpy as np\nimport yaml\n\nSRC = r\"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\"\nsys.path.insert(0, SRC + r\"\\pps_perception_bringup\")\nfrom pps_perception_bringup.synthetic_scene import (  # noqa: E402\n    HALF_H,\n    HALF_W,\n    TZ_M,\n    face_bbox_rgb,\n    load_camera,\n    render_depth_mm,\n)\n\nCAM_YAML = SRC + r\"\\pps_perception_bringup\\config\\camera.yaml\"\n\n\ndef sample_segment(p0, p1, spacing):\n    length = float(np.linalg.norm(p1 - p0))\n    n = max(2, int(math.ceil(length / spacing)) + 1)\n    out = []\n    for i in range(n):\n        t = i / n\n        out.append(p0 + t * (p1 - p0))\n    return np.asarray(out)\n\n\ndef sample_rect(w, h, cx, cy, spacing):\n    hw, hh = 0.5 * w, 0.5 * h\n    corners = np.array(\n        [\n            [cx - hw, cy - hh],\n            [cx + hw, cy - hh],\n            [cx + hw, cy + hh],\n            [cx - hw, cy + hh],\n        ]\n    )\n    parts = [sample_segment(corners[i], corners[(i + 1) % 4], spacing) for i in range(4)]\n    return np.vstack(parts)\n\n\ndef prototype(w, h, pw, ph, poff, spacing):\n    outer = sample_rect(w, h, 0, 0, spacing)\n    hole_l = sample_rect(pw, ph, -poff, 0, spacing)\n    hole_r = sample_rect(pw, ph, poff, 0, spacing)\n    return np.vstack([outer, hole_l, hole_r])\n\n\ndef build_mask(bbox, h, w, erode_px=2):\n    x1, y1, x2, y2 = bbox\n    x1i = max(0, int(round(min(x1, x2))))\n    y1i = max(0, int(round(min(y1, y2))))\n    x2i = min(w, int(round(max(x1, x2))))\n    y2i = min(h, int(round(max(y1, y2))))\n    mask = np.zeros((h, w), np.uint8)\n    if x2i > x1i and y2i > y1i:\n        mask[y1i:y2i, x1i:x2i] = 1\n    if erode_px > 0:\n        kernel = np.ones((3, 3), np.uint8)\n        mask = cv2.erode(mask, kernel, iterations=erode_px)\n    return mask\n\n\ndef sample_points(depth_m, mask_rgb, cam):\n    K_d = np.array(\n        [[cam.depth.fx, 0, cam.depth.cx], [0, cam.depth.fy, cam.depth.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    K_d_inv = np.linalg.inv(K_d)\n    K_r = np.array(\n        [[cam.rgb.fx, 0, cam.rgb.cx], [0, cam.rgb.fy, cam.rgb.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    Hd, Wd = depth_m.shape\n    pts = []\n    for v in range(Hd):\n        row = depth_m[v]\n        for u in range(Wd):\n            z = float(row[u])\n            if not np.isfinite(z) or z < 0.3 or z > 5.0:\n                continue\n            ray = K_d_inv @ np.array([u, v, 1.0])\n            p_d = ray * z\n            p_r = cam.R_dr @ p_d + cam.t_dr\n            if p_r[2] <= 0:\n                continue\n            uv = np.array(\n                [\n                    K_r[0, 0] * p_r[0] / p_r[2] + K_r[0, 2],\n                    K_r[1, 1] * p_r[1] / p_r[2] + K_r[1, 2],\n                ]\n            )\n            ui, vi = int(round(uv[0])), int(round(uv[1]))\n            if ui < 0 or ui >= cam.rgb.width or vi < 0 or vi >= cam.rgb.height:\n                continue\n            if mask_rgb[vi, ui] == 0:\n                continue\n            pts.append(p_d)\n    return np.asarray(pts)\n\n\ndef plane_basis(points):\n    centroid = points.mean(axis=0)\n    _, _, vt = np.linalg.svd(points - centroid, full_matrices=False)\n    normal = vt[-1]\n    if normal[2] > 0:\n        normal = -normal\n    offset = -float(normal @ centroid)\n    origin = -offset * normal\n    e_up = np.array([0.0, -1.0, 0.0])\n    if abs(e_up @ normal) > 0.95:\n        e_up = np.array([1.0, 0.0, 0.0])\n    u = e_up - (e_up @ normal) * normal\n    axis_u = u / np.linalg.norm(u)\n    if axis_u[0] < 0:\n        axis_u = -axis_u\n    axis_v = np.cross(normal, axis_u)\n    axis_v = axis_v / np.linalg.norm(axis_v)\n    return normal, offset, origin, axis_u, axis_v\n\n\ndef project_2d(points, origin, axis_u, axis_v):\n    rel = points - origin\n    return np.column_stack([rel @ axis_u, rel @ axis_v])\n\n\ndef rasterize(points, resolution, padding):\n    min_xy = points.min(axis=0) - padding\n    max_xy = points.max(axis=0) + padding\n    width = int(math.ceil((max_xy[0] - min_xy[0]) / resolution)) + 1\n    height = int(math.ceil((max_xy[1] - min_xy[1]) / resolution)) + 1\n    mask = np.zeros((height, width), np.uint8)\n    cols = np.rint((points[:, 0] - min_xy[0]) / resolution).astype(int)\n    rows = np.rint((points[:, 1] - min_xy[1]) / resolution).astype(int)\n    ok = (rows >= 0) & (rows < height) & (cols >= 0) & (cols < width)\n    mask[rows[ok], cols[ok]] = 1\n    return mask, min_xy, resolution\n\n\ndef close_and_edge(mask, close_radius=2):\n    src = mask.copy()\n    if close_radius > 0:\n        k = 2 * close_radius + 1\n        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k, k))\n        src = cv2.morphologyEx(src, cv2.MORPH_CLOSE, kernel)\n    n, labels, stats, _ = cv2.connectedComponentsWithStats(src, 8)\n    if n > 1:\n        areas = stats[1:, cv2.CC_STAT_AREA]\n        largest = 1 + int(np.argmax(areas))\n        src = (labels == largest).astype(np.uint8)\n    kernel = np.ones((3, 3), np.uint8)\n    eroded = cv2.erode(src, kernel, iterations=1)\n    edge = cv2.bitwise_and(src, cv2.bitwise_not(eroded))\n    return edge\n\n\ndef dist_transform(edge, resolution):\n    src = np.where(edge != 0, 0, 1).astype(np.uint8)\n    dist_px = cv2.distanceTransform(src, cv2.DIST_L2, cv2.DIST_MASK_PRECISE)\n    return dist_px.astype(np.float32) * resolution\n\n\ndef sample_bilinear(points, dist, min_xy, resolution, penalty):\n    H, W = dist.shape\n    col_f = (points[:, 0] - min_xy[0]) / resolution\n    row_f = (points[:, 1] - min_xy[1]) / resolution\n    c0 = np.floor(col_f).astype(int)\n    r0 = np.floor(row_f).astype(int)\n    dx = col_f - c0\n    dy = row_f - r0\n    out = np.full(points.shape[0], penalty)\n    ok = (r0 >= 0) & (r0 + 1 < H) & (c0 >= 0) & (c0 + 1 < W)\n    r0o, c0o, dxo, dyo = r0[ok], c0[ok], dx[ok], dy[ok]\n    d00 = dist[r0o, c0o]\n    d01 = dist[r0o, c0o + 1]\n    d10 = dist[r0o + 1, c0o]\n    d11 = dist[r0o + 1, c0o + 1]\n    out[ok] = (1 - dxo) * (1 - dyo) * d00 + dxo * (1 - dyo) * d01 + (1 - dxo) * dyo * d10 + dxo * dyo * d11\n    return out\n\n\ndef trimmed_mean(distances, trim=0.10):\n    s = np.sort(distances)\n    keep = max(1, int(math.ceil((1 - trim) * len(s))))\n    return float(s[:keep].mean())\n\n\ndef chamfer(proto, theta, tx, ty, dist, min_xy, resolution):\n    c, s = math.cos(theta), math.sin(theta)\n    R = np.array([[c, -s], [s, c]])\n    pts = proto @ R.T\n    pts = pts + np.array([tx, ty])\n    penalty = 50.0 * resolution\n    return trimmed_mean(sample_bilinear(pts, dist, min_xy, resolution, penalty))\n\n\ndef ray_plane(uv, cam, normal, offset):\n    K_r = np.array(\n        [[cam.rgb.fx, 0, cam.rgb.cx], [0, cam.rgb.fy, cam.rgb.cy], [0, 0, 1]],\n        dtype=np.float64,\n    )\n    ray_r = np.linalg.inv(K_r) @ np.array([uv[0], uv[1], 1.0])\n    R_rd = cam.R_dr.T\n    t_rd = -R_rd @ cam.t_dr\n    origin_d = t_rd\n    dir_d = R_rd @ ray_r\n    denom = float(normal @ dir_d)\n    t = -(float(normal @ origin_d) + offset) / denom\n    return origin_d + t * dir_d\n\n\ndef main():\n    cam = load_camera(CAM_YAML)\n    depth_mm = render_depth_mm(cam, tz=TZ_M)\n    depth_m = depth_mm.astype(np.float32) * 0.001\n    depth_m[depth_mm == 0] = 0\n    bbox = face_bbox_rgb(cam, tz=TZ_M)\n    mask = build_mask(bbox, cam.rgb.height, cam.rgb.width, 2)\n    print(\"sampling points...\")\n    pts = sample_points(depth_m, mask, cam)\n    print(\"n_points\", len(pts))\n    normal, offset, origin, axis_u, axis_v = plane_basis(pts)\n    obs = project_2d(pts, origin, axis_u, axis_v)\n    print(\"obs aabb center\", obs.min(0), obs.max(0), 0.5 * (obs.min(0) + obs.max(0)))\n    print(\"obs mean\", obs.mean(0))\n\n    resolution = 0.005\n    mask_r, min_xy, res = rasterize(obs, resolution, 0.80)\n    edge = close_and_edge(mask_r, 2)\n    dist = dist_transform(edge, res)\n\n    # default prototype vs scene-matched prototype\n    configs = {\n        \"default_model\": prototype(1.20, 0.14, 0.47, 0.10, 0.28, 0.03),\n        \"scene_model\": prototype(2 * HALF_W, 2 * HALF_H, 0.30, 0.10, 0.30, 0.03),\n    }\n\n    centre_uv = np.array([0.5 * (bbox[0] + bbox[2]), 0.5 * (bbox[1] + bbox[3])])\n    centre_d = ray_plane(centre_uv, cam, normal, offset)\n    centre_2d = project_2d(centre_d.reshape(1, 3), origin, axis_u, axis_v)[0]\n    true_d = np.array([0.0, 0.0, TZ_M])\n    true_r = cam.R_dr @ true_d + cam.t_dr\n    print(\"bbox centre 2d\", centre_2d, \"3d err mm\", 1000 * np.linalg.norm(centre_d - true_d))\n    print(\"true rgb\", true_r)\n\n    def pose_err_mm(tx, ty):\n        p = origin + tx * axis_u + ty * axis_v\n        pr = cam.R_dr @ p + cam.t_dr\n        return 1000 * np.linalg.norm(pr - true_r), p\n\n    print(\"init pose err mm\", pose_err_mm(centre_2d[0], centre_2d[1])[0])\n\n    aabb_c = 0.5 * (obs.min(0) + obs.max(0))\n    print(\"aabb pose err mm\", round(pose_err_mm(aabb_c[0], aabb_c[1])[0], 3))\n\n    for name, proto in configs.items():\n        best = None\n        thetas = [math.pi / 2 + math.radians(d) for d in (0, 0.2, -0.2, 1.0, -1.0)]\n        thetas += [-math.pi / 2 + math.radians(d) for d in (0, 0.2, -0.2)]\n        costs_at_centre = []\n        for th in thetas:\n            c0 = chamfer(proto, th, centre_2d[0], centre_2d[1], dist, min_xy, res)\n            costs_at_centre.append((c0, th))\n            for iy in range(-8, 9):\n                ty = centre_2d[1] + iy * 0.001\n                for ix in range(-8, 9):\n                    tx = centre_2d[0] + ix * 0.001\n                    cost = chamfer(proto, th, tx, ty, dist, min_xy, res)\n                    if best is None or cost < best[0]:\n                        best = (cost, th, tx, ty)\n        err, _ = pose_err_mm(best[2], best[3])\n        shift = math.hypot(best[2] - centre_2d[0], best[3] - centre_2d[1])\n        centre_best = min(costs_at_centre)\n        print(\n            name,\n            \"centre_cost\",\n            round(centre_best[0], 6),\n            \"centre_theta\",\n            round(centre_best[1], 5),\n            \"best_cost\",\n            round(best[0], 6),\n            \"theta\",\n            round(best[1], 5),\n            \"dxy_mm\",\n            round(1000 * (best[2] - centre_2d[0]), 3),\n            round(1000 * (best[3] - centre_2d[1]), 3),\n            \"shift_mm\",\n            round(1000 * shift, 3),\n            \"pose_err_mm\",\n            round(err, 3),\n        )\n\n\nif __name__ == \"__main__\":\n    main()\n","message":"The file C:\\Users\\alanpeng\\AppData\\Local\\Temp\\pose_bias_probe.py has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call-d5430426-abc9-48a5-97b9-4a09786840c7-65\nfc_3dd1b2a5-8493-9b63-95c3-af1125607f6e_0","startedAtMs":"1790668761578","completedAtMs":"1790668763564"},"model_call_id":"0b69c872-e212-4af5-9a05-b8b426701c94-35-eiau","session_id":"458c9a0c-35f1-4ea1-bc25-0820578bc0fd","timestamp_ms":1790668762804}
