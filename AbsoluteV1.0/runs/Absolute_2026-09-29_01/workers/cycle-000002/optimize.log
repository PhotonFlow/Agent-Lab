ide_penalty_m,\n                                 ChamferTls& tls) {\n  const double penalty = outside_penalty_or_default(outside_penalty_m, meta);\n  sample_bilinear_offset_into(rotated, tx, ty, dist_img_m, meta, penalty, tls.distances);\n  return trimmed_mean_from_distances(tls.distances, trim_fraction, tls.sorted);\n}\n\ndouble chamfer_cost_from_rotated_reject(const Eigen::MatrixXd& rotated, double tx, double ty,\n                                        const cv::Mat& dist_img_m, const GridMeta& meta,\n                                        double trim_fraction, const double* outside_penalty_m,\n                                        ChamferTls& tls, double reject_at, double* anchor_out) {\n  const double penalty = outside_penalty_or_default(outside_penalty_m, meta);\n  sample_bilinear_offset_into(rotated, tx, ty, dist_img_m, meta, penalty, tls.distances);\n  const double lower = histogram_lower_mean(tls.distances, trim_fraction);\n  if (lower > reject_at) {\n    if (anchor_out != nullptr) {\n      *anchor_out = lower;\n    }\n    return reject_at;\n  }\n  const double exact = trimmed_mean_from_distances(tls.distances, trim_fraction, tls.sorted);\n  if (anchor_out != nullptr) {\n    *anchor_out = exact;\n  }\n  return exact;\n}\n\nbool search_window_inside(const Eigen::MatrixXd& rotated, double tx_lo, double tx_hi,\n                          double ty_lo, double ty_hi, const GridMeta& meta, int rows, int cols) {\n  if (rotated.rows() <= 0 || !(meta.resolution_m > 0.0)) {\n    return false;\n  }\n  const double min_x = rotated.col(0).minCoeff();\n  const double max_x = rotated.col(0).maxCoeff();\n  const double min_y = rotated.col(1).minCoeff();\n  const double max_y = rotated.col(1).maxCoeff();\n  const double res = meta.resolution_m;\n  const double col_lo = (min_x + tx_lo - meta.min_xy.x()) / res;\n  const double col_hi = (max_x + tx_hi - meta.min_xy.x()) / res;\n  const double row_lo = (min_y + ty_lo - meta.min_xy.y()) / res;\n  const double row_hi = (max_y + ty_hi - meta.min_xy.y()) / res;\n  // One-pixel margin so the bilinear neighbourhood stays on the image.\n  return col_lo >= 1.0 && row_lo >= 1.0 && col_hi <= static_cast<double>(cols) - 2.0 &&\n         row_hi <= static_cast<double>(rows) - 2.0;\n}\n\n}  // namespace chamfer_detail\n\ndouble chamfer_cost_v2(const Eigen::Ref<const Eigen::MatrixXd>& proto_points_2d,\n                        const PrototypePose2D& pose, const cv::Mat& dist_img_m,\n                        const GridMeta& meta, double trim_fraction,\n                        const double* outside_penalty_m) {\n  chamfer_detail::ChamferTls& tls = chamfer_detail::chamfer_tls();\n  chamfer_detail::ensure_tls_size(tls, proto_points_2d.rows());\n  chamfer_detail::rotate_proto_into(proto_points_2d, pose.theta_rad, tls.rotated);\n  return chamfer_detail::chamfer_cost_from_rotated(tls.rotated, pose.tx, pose.ty,\n                                                    dist_img_m, meta, trim_fraction,\n                                                    outside_penalty_m, tls);\n}\n\nstd::pair<PrototypePose2D, double> coarse_chamfer_search_v2(\n    const Eigen::Ref<const Eigen::MatrixXd>& proto_points_2d,\n    const PrototypePose2D& init_pose, const cv::Mat& dist_img_m, const GridMeta& meta,\n    double search_dx_m, double search_dy_m, double search_dtheta_rad, double step_dx_m,\n    double step_dy_m, double step_dtheta_rad, double trim_fraction,\n    const double* outside_penalty_m) {\n  std::vector<double> dx_values;\n  dx_values.reserve(\n      static_cast<size_t>(std::floor((2.0 * search_dx_m) / step_dx_m)) + 2);","isEmpty":false,"exceededLimit":false,"totalLines":481,"fileSize":20046,"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\geometry_core\\src\\chamfer.cpp","readRange":{"startLine":250,"endLine":369},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-45f4e502-4e74-4537-a491-e08ae00ac6a0-95