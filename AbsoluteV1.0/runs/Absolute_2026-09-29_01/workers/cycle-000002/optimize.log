34.171875000, 1920, 1080};\n  cam.depth = geometry_core::PinholeIntrinsics{393.154327393, 411.884765625, 317.828948975,\n                                               244.208724976, 640, 480};\n  cam.R_dr << 0.999999583, 0.000757446, -0.000565665, -0.000758366, 0.999998391, -0.001626925,\n      0.000564432, 0.001627354, 0.999998510;\n  cam.t_dr = Eigen::Vector3d(-21.928760529, -0.326392442, -0.799158454) * 1e-3;\n  cam.depth_scale = 0.001;\n\n  const double tz = 2.0;\n  const double half_w = 0.60;\n  const double half_h = 0.40;\n  const double pocket_half_w = 0.15;\n  const double pocket_half_h = 0.05;\n  const double pocket_offset = 0.30;\n  cv::Mat depth(480, 640, CV_32FC1, cv::Scalar(0));\n  for (int v = 0; v < 480; ++v) {\n    for (int u = 0; u < 640; ++u) {\n      const double x = (u - cam.depth.cx) / cam.depth.fx * tz;\n      const double y = (v - cam.depth.cy) / cam.depth.fy * tz;\n      const bool on_face = std::abs(x) <= half_w && std::abs(y) <= half_h;\n      const bool in_pocket =\n          std::abs(y) <= pocket_half_h &&\n          (std::abs(x - pocket_offset) <= pocket_half_w ||\n           std::abs(x + pocket_offset) <= pocket_half_w);\n      if (on_face && !in_pocket) {\n        depth.at<float>(v, u) = static_cast<float>(tz);\n      }\n    }\n  }\n\n  // RGB bbox from the four face corners, matching synthetic_scene.face_bbox_rgb.\n  Eigen::Matrix<double, 4, 3> corners;\n  corners << -half_w, -half_h, tz, half_w, -half_h, tz, half_w, half_h, tz, -half_w, half_h, tz;\n  Eigen::Matrix<double, 4, 3> corners_r = corners * cam.R_dr.transpose();\n  corners_r.rowwise() += cam.t_dr.transpose();\n  double x1 = 1e9, y1 = 1e9, x2 = -1e9, y2 = -1e9;\n  for (int i = 0; i < 4; ++i) {\n    const double u = cam.rgb.fx * corners_r(i, 0) / corners_r(i, 2) + cam.rgb.cx;\n    const double v = cam.rgb.fy * corners_r(i, 1) / corners_r(i, 2) + cam.rgb.cy;\n    x1 = std::min(x1, u);\n    y1 = std::min(y1, v);\n    x2 = std::max(x2, u);\n    y2 = std::max(y2, v);\n  }\n  Eigen::Vector4d bbox(x1, y1, x2, y2);\n  std::cout << \"bbox \" << bbox.transpose() << \"\\n\";\n\n  geometry_core::Stage2Config cfg;\n  geometry_core::EstimatePoseParams params;\n  std::mt19937_64 rng(0);\n\n  auto t0 = clock_type::now();\n  auto outcome = geometry_core::estimate_pose_chamfer_v3_2(bbox, depth, cam, cfg, params,\n                                                            std::nullopt, rng);\n  std::cout << \"full_ms \" << ms_since(t0) << \" ok \" << outcome.ok << \" tz \" << outcome.pose.tz\n            << \" yaw \" << outcome.pose.yaw_rad << \" cost \" << outcome.debug.chamfer_cost_m\n            << \" conf \" << outcome.debug.confidence << \" prior \" << outcome.debug.used_prior_fallback\n            << \" lambda \" << outcome.debug.prior_lambda_eff << \" raster \"\n            << outcome.debug.raster_h << \"x\" << outcome.debug.raster_w << \" nface \"\n            << outcome.pose.n_face_points << \"\\n\";\n\n  // Repeat full call for a steadier number.\n  double sum = 0;\n  const int reps = 3;\n  for (int i = 0; i < reps; ++i) {\n    std::mt19937_64 rng_i(0);\n    t0 = clock_type::now();\n    outcome = geometry_core::estimate_pose_chamfer_v3_2(bbox, depth, cam, cfg, params,\n                                                         std::nullopt, rng_i);\n    sum += ms_since(t0);\n  }\n  std::cout << \"full_avg_ms \" << (sum / reps) << \"\\n\";\n\n  t0 = clock_type::now();\n  cv::Mat mask = geometry_core::build_bbox_mask(bbox, cam.rgb.height, cam.rgb.width, cfg.erode_px);\n  std::cout << \"mask_ms \" << ms_since(t0) << \" nnz \" << cv::countNonZero(mask) << \"\\n\";\n\n  t0 = clock_type::now();\n  auto samples = geometry_core::sample_face_points(depth, mask, cam, cfg);\n  std::cout << \"sample_ms \" << ms_since(t0) << \" n \" << samples.points_depth_frame.rows() << \"\\n\";\n\n  t0 = clock_type::now();\n  std::mt19937_64 rng2(0);\n  auto plane = geometry_core::ransac_plane_fit(samples.points_depth_frame,\n                                                cfg.plane_inlier_threshold_m, cfg.ransac_iters,\n                                                cfg.ransac_min_inlier_ratio_early_stop, rng2);\n  std::cout << \"ransac_ms \" << ms_since(t0) << \" inliers \" << plane.n_inliers << \"\\n\";\n\n  auto proto = geometry_core::build_default_pallet_prototype(\n      params.pallet_width_m, params.pallet_height_m, params.pocket_width_m, params.pocket_height_m,\n      params.pocket_centre_offset_m, params.contour_spacing_m);\n  std::cout << \"proto_n \" << proto.contour_points.rows() << \"\\n\";\n\n  // Isolate chamfer search on a modest distance image similar to production resolution.\n  Eigen::MatrixXd obs = proto.contour_points;\n  t0 = clock_type::now();\n  auto [omask, meta] =\n      geometry_core::rasterize_points_to_mask(obs, params.resolution_m, params.padding_m);\n  cv::Mat filled = geometry_core::close_mask(omask, params.close_radius_px, true);\n  cv::Mat edge = geometry_core::extract_boundary_mask(filled);\n  cv::Mat dist = geometry_core::compute_distance_transform_v2(edge, meta.resolution_m);\n  std::cout << \"dt_ms \" << ms_since(t0) << \" grid \" << meta.height << \"x\" << meta.width << \"\\n\";\n\n  geometry_core::PrototypePose2D init{0.0, 0.0, 0.0};\n  t0 = clock_type::now();\n  auto searched = geometry_core::two_stage_chamfer_search_v2(\n      proto.contour_points, init, dist, meta, params.coarse_dx_m, params.coarse_dy_m,\n      params.coarse_dtheta_rad, params.coarse_step_dx_m, params.coarse_step_dy_m,\n      params.coarse_step_dtheta_rad, params.fine_dx_m, params.fine_dy_m, params.fine_dtheta_rad,\n      params.fine_step_dx_m, params.fine_step_dy_m, params.fine_step_dtheta_rad,\n      params.trim_fraction, nullptr);\n  std::cout << \"chamfer_ms \" << ms_since(t0) << \" cost \" << searched.second << \"\\n\";\n\n  // Sort microbench: n=proto, 30000 times.\n  const long n = proto.contour_points.rows();\n  std::vector<double> vals(static_cast<size_t>(n));\n  std::mt19937 rngs(1);\n  std::uniform_real_distribution<double> uni(0.0, 0.05);\n  for (auto& v : vals) v = uni(rngs);\n  t0 = clock_type::now();\n  double acc = 0;\n  for (int rep = 0; rep < 30000; ++rep) {\n    std::vector<double> s = vals;\n    s[0] += rep * 1e-12;\n    std::sort(s.begin(), s.end());\n    long keep = std::max<long>(1, static_cast<long>(std::ceil(0.9 * n)));\n    double sumk = 0;\n    for (long i = 0; i < keep; ++i) sumk += s[static_cast<size_t>(i)];\n    acc += sumk;\n  }\n  std::cout << \"sort30k_ms \" << ms_since(t0) << \" acc \" << acc << \"\\n\";\n  return 0;\n}\n","message":"Wrote contents to C:\\Users\\alanpeng\\AppData\\Local\\Temp\\absbench\\bench.cpp"}}},"hookAdditionalContexts":[],"toolCallId":"call-acb4c2e6-0845-4907-94f1-1f23396e4163-55\nfc_89078173-b69b-9765-8bbe-e4e9c2d29f5a_0","startedAtMs":"1790669809915","completedAtMs":"1790669810588"},"model_call_id":"bc9e15bd-1862-4d6e-8956-2ad62b57ffa6-24-5zsq","session_id":"685dda58-1e4d-40cf-a684-4618b8dbe2fa","timestamp_ms":1790669809749}
