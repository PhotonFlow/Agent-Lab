{"type":"tool_call","subtype":"completed","call_id":"call-79ef141d-f20d-4385-a0a0-2ea88c438ece-20\nfc_fd2727fa-77ba-9d5e-937b-8028baf5b862_3","tool_call":{"readToolCall":{"args":{"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\pps_perception_bringup\\test\\test_full_pipeline_launch.py"},"result":{"success":{"content":"\"\"\"Full mock-input pipeline launch test.\n\nBrings up scene publisher -> mock RT-DETR detector -> chamfer stage-2 and\nasserts a pose is published on ``/pps/pallet_pose`` with a plausible range\n(tz ~ 2 m, the synthetic pallet distance) within a timeout.\n\nRun with: ``launch_test src/pps_perception_bringup/test/test_full_pipeline_launch.py``\nor via ``colcon test``.\n\"\"\"\n\nimport time\nimport unittest\n\nimport numpy as np\nimport pytest\nimport rclpy\nfrom geometry_msgs.msg import PoseStamped\nfrom launch import LaunchDescription\nfrom launch_testing.actions import ReadyToTest\n\nfrom pps_perception_bringup.pipeline_nodes import POSE_TOPIC, mock_pipeline_nodes\n\n\n@pytest.mark.launch_test\ndef generate_test_description():\n    return LaunchDescription([*mock_pipeline_nodes(), ReadyToTest()])\n\n\nclass TestMockPipeline(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        rclpy.init()\n\n    @classmethod\n    def tearDownClass(cls):\n        rclpy.shutdown()\n\n    def setUp(self):\n        self.node = rclpy.create_node(\"mock_pipeline_test_listener\")\n\n    def tearDown(self):\n        self.node.destroy_node()\n\n    def test_pose_published_with_plausible_range(self):\n        received = []\n        self.node.create_subscription(\n            PoseStamped, POSE_TOPIC, lambda m: received.append(m), 10\n        )\n\n        deadline = time.time() + 40.0\n        while time.time() < deadline and not received:\n            rclpy.spin_once(self.node, timeout_sec=0.2)\n\n        self.assertTrue(received, f\"no PoseStamped received on {POSE_TOPIC} within timeout\")\n        pose = received[-1].pose\n        x, y, z = pose.position.x, pose.position.y, pose.position.z\n        self.assertTrue(np.isfinite([x, y, z]).all(), f\"non-finite pose: {x}, {y}, {z}\")\n        # Synthetic pallet is frontal at tz = 2.0 m.\n        self.assertTrue(1.5 < z < 2.5, f\"implausible tz={z:.3f} (expected ~2.0 m)\")\n        self.assertLess(abs(x), 0.20, f\"implausible tx={x:.3f}\")\n        self.assertLess(abs(y), 0.20, f\"implausible ty={y:.3f}\")\n","isEmpty":false,"exceededLimit":false,"totalLines":62,"fileSize":2070,"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\pps_perception_bringup\\test\\test_full_pipeline_launch.py","readRange":{"startLine":1,"endLine":62},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-79ef141d-f20d-4385-a0a0-2ea88c438ece-20\nfc_fd2727fa-77ba-9d5e-937b-8028baf5b862_3","startedAtMs":"1790666821677","completedAtMs":"1790666821952"},"model_call_id":"74641e36-f24a-4420-ac2e-6c10550e227e-8-ty0w","session_id":"8ec5d46b-6013-48bf-8b48-17d81e3480ec","timestamp_ms":1790666821149}
