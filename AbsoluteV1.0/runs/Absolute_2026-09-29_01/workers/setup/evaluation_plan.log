put=\"screen\",\n        parameters=[\n            {\n                \"backend\": \"mock\",\n                \"input_size\": 640,\n                \"score_threshold\": 0.5,\n                \"pallet_class_id\": 0,\n                \"class_label\": \"pallet\",\n                \"image_topic\": RGB_TOPIC,\n                \"detections_topic\": DETECTIONS_TOPIC,\n                \"image_qos\": \"reliable\",\n                \"mock_bbox_xyxy\": bbox,\n                \"mock_score\": 0.95,\n            }\n        ],\n    )\n    pose = Node(\n        package=\"pps_pallet_pose_cpp\",\n        executable=\"pallet_pose_cpp_node\",\n        name=\"pallet_pose_cpp_node\",\n        output=\"screen\",\n        parameters=[\n            {\n                \"camera_yaml_path\": camera_yaml,\n                \"target_class_id\": \"pallet\",\n                \"detection_selection\": \"highest_confidence\",\n                \"depth_topic\": DEPTH_TOPIC,\n                \"detections_topic\": DETECTIONS_TOPIC,\n                \"pose_topic\": POSE_TOPIC,","isEmpty":false,"exceededLimit":false,"totalLines":87,"fileSize":2719,"path":"C:\\Users\\alanpeng\\Desktop\\Self-envolve_agent\\AbsoluteV1.0\\runs\\Absolute_2026-09-29_01\\package\\src\\pps_perception_bringup\\pps_perception_bringup\\pipeline_nodes.py","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f6145627-6ab2-491c-bbaa-7876e3ad0564-50\nfc_51ca8d15-888a-9bb0-a982-8eac72a3ab48_1","startedAtMs":"1790666457650","completedAtMs":"1790666458501"},"model_call_id":"fb099c48-1f9b-48db-85d4-9249b40aadc0-26-0uhw","session_id":"18e0c2e0-4827-4442-9c2c-d806cbec0f99","timestamp_ms":1790666457717}
